<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nikkiward.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:background="using:Nikkiward.Features.Background"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:Nikkiward.Features.Shell"
    x:DefaultBindMode="OneWay"
    Background="Transparent"
    Loaded="OnPageLoaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="Transparent">
        <background:ArtBackdropView
            x:Name="LauncherBackground"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Border
            x:Name="PageHostBackdrop"
            Margin="0"
            Background="{ThemeResource PaperBaseBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border x:Name="NativeSurfacePaper" />
        </Border>

        <Frame
            x:Name="ContentFrame"
            Margin="0"
            Background="Transparent"
            IsNavigationStackEnabled="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
