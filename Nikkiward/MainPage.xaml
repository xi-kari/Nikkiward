<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Nikkiward.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:background="using:Nikkiward.Features.Background"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="using:Nikkiward.Features.Shell"
    x:DefaultBindMode="OneWay"
    Background="Transparent"
    KeyDown="OnPageKeyDown"
    Loaded="OnPageLoaded"
    RequestedTheme="Dark"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        SizeChanged="OnRootGridSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ShellWidthStates">
                <VisualState x:Name="NarrowLaunchSettingsHost">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LaunchSettingsFrame.Margin" Value="8,48,8,8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLaunchSettingsHost">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LaunchSettingsFrame.Margin" Value="24,60,24,24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <background:ArtBackdropView
            x:Name="LauncherBackground"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <Grid
            x:Name="OnArtScrim"
            IsHitTestVisible="False"
            Opacity="0.22"
            RequestedTheme="Dark">

            <Rectangle
                Fill="{ThemeResource OnArtScrimBrush}"
                IsHitTestVisible="False"
                Opacity="0.34" />

            <Rectangle
                Width="220"
                HorizontalAlignment="Right"
                IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{ThemeResource OnArtScrimTransparentColor}" />
                        <GradientStop Offset="0.7" Color="{ThemeResource OnArtScrimColor}" />
                        <GradientStop Offset="1" Color="{ThemeResource OnArtScrimColor}" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle
                Height="200"
                Margin="0"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{ThemeResource OnArtScrimTransparentColor}" />
                        <GradientStop Offset="0.62" Color="{ThemeResource OnArtScrimColor}" />
                        <GradientStop Offset="1" Color="{ThemeResource OnArtScrimColor}" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Border
            x:Name="PageHostBackdrop"
            Margin="0"
            Background="{ThemeResource PaperBaseBrush}"
            IsHitTestVisible="False"
            Visibility="Collapsed" />

        <Frame
            x:Name="ContentFrame"
            Margin="0"
            Background="Transparent"
            IsNavigationStackEnabled="False"
            Visibility="Collapsed" />
        <shell:HomeNavigation x:Name="ShellNavigation" HorizontalAlignment="Left" VerticalAlignment="Top"
            SizeChanged="OnHomeNavigationSizeChanged" />
        <Border
            x:Name="DrawerMask"
            Margin="0"
            Background="{ThemeResource DrawerMaskBrush}"
            IsHitTestVisible="True"
            Tapped="OnDrawerMaskTapped"
            Visibility="Collapsed">
        </Border>

        <Border
            x:Name="StatusDrawer"
            Width="560"
            Margin="0,58,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="{ThemeResource HomeSurfaceBrush}"
            BorderBrush="{ThemeResource HomeStrokeBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusIsland}"
            Shadow="{ThemeResource HomeElevation}"
            Translation="0,0,32"
            Visibility="Collapsed">
            <Frame
                x:Name="StatusFrame"
                Background="Transparent"
                IsNavigationStackEnabled="False" />
        </Border>

        <Border
            x:Name="LaunchSettingsMask"
            Margin="0"
            Background="{ThemeResource LaunchSettingsMaskBrush}"
            IsHitTestVisible="True"
            Tapped="OnLaunchSettingsMaskTapped"
            Visibility="Collapsed" />

        <Frame
            x:Name="LaunchSettingsFrame"
            MaxWidth="1120"
            MaxHeight="690"
            Margin="24,60,24,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            IsNavigationStackEnabled="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
