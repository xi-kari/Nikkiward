<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme-aware paper glass, island edges, and art scrims. -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ============================ LIGHT ============================ -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="GlassPillBrush" Color="#B8F6F1EA" />
            <SolidColorBrush x:Key="GlassIslandBrush" Color="#C7F6F1EA" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#EBF6F1EA" />
            <SolidColorBrush x:Key="PaperGlassBrush" Color="#C7F6F1EA" />
            <SolidColorBrush x:Key="PaperGlassStrongBrush" Color="#EBF6F1EA" />
            <SolidColorBrush x:Key="IslandInnerRingBrush" Color="#14241E1B" />

            <!-- 1px inset stroke: light catches the top left, shade pools bottom right. -->
            <LinearGradientBrush x:Key="IslandEdgeHighlightBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Offset="0" Color="#59FFFFFF" />
                <GradientStop Offset="0.45" Color="#1FFFFFFF" />
                <GradientStop Offset="1" Color="#26000000" />
            </LinearGradientBrush>

            <!-- Warm alpha-only vignette over outfit art. -->
            <LinearGradientBrush x:Key="ArtVignetteBrush"
                                 StartPoint="0.5,0"
                                 EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00241E1B" />
                <GradientStop Offset="0.55" Color="#14241E1B" />
                <GradientStop Offset="1" Color="#59241E1B" />
            </LinearGradientBrush>

            <!-- Flat scrim for text protection over art. -->
            <SolidColorBrush x:Key="ScrimOverlayBrush" Color="#33000000" />

            <LinearGradientBrush
                x:Key="ArtVignetteStrongBrush"
                StartPoint="0.5,0"
                EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#18241E1B" />
                <GradientStop Offset="0.52" Color="#64241E1B" />
                <GradientStop Offset="1" Color="#F0241E1B" />
            </LinearGradientBrush>
            <Color x:Key="ArtHeroShadeDeepColor">#F0241E1B</Color>
            <Color x:Key="ArtHeroShadeStrongColor">#B8241E1B</Color>
            <Color x:Key="ArtHeroShadeSoftColor">#5C241E1B</Color>

        </ResourceDictionary>

        <!-- ============================= DARK ============================= -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="GlassPillBrush" Color="#B8241E1B" />
            <SolidColorBrush x:Key="GlassIslandBrush" Color="#C7241E1B" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="#EB241E1B" />
            <SolidColorBrush x:Key="PaperGlassBrush" Color="#C7241E1B" />
            <SolidColorBrush x:Key="PaperGlassStrongBrush" Color="#EB241E1B" />
            <SolidColorBrush x:Key="IslandInnerRingBrush" Color="#14FFFFFF" />

            <!-- Softer top highlight, deeper bottom shade so edges still read on charcoal. -->
            <LinearGradientBrush x:Key="IslandEdgeHighlightBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Offset="0" Color="#40FFFFFF" />
                <GradientStop Offset="0.45" Color="#1FFFFFFF" />
                <GradientStop Offset="1" Color="#40000000" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="ArtVignetteBrush"
                                 StartPoint="0.5,0"
                                 EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00241E1B" />
                <GradientStop Offset="0.55" Color="#26241E1B" />
                <GradientStop Offset="1" Color="#73241E1B" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="ScrimOverlayBrush" Color="#4D000000" />

            <LinearGradientBrush
                x:Key="ArtVignetteStrongBrush"
                StartPoint="0.5,0"
                EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#18241E1B" />
                <GradientStop Offset="0.52" Color="#64241E1B" />
                <GradientStop Offset="1" Color="#F0241E1B" />
            </LinearGradientBrush>
            <Color x:Key="ArtHeroShadeDeepColor">#F0241E1B</Color>
            <Color x:Key="ArtHeroShadeStrongColor">#B8241E1B</Color>
            <Color x:Key="ArtHeroShadeSoftColor">#5C241E1B</Color>

        </ResourceDictionary>

        <!-- ========================= HIGH CONTRAST ========================= -->
        <ResourceDictionary x:Key="HighContrast">

            <SolidColorBrush x:Key="GlassPillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="GlassIslandBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperGlassStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="IslandInnerRingBrush" Color="Transparent" />
            <SolidColorBrush x:Key="IslandEdgeHighlightBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ArtVignetteBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="ScrimOverlayBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.7" />
            <SolidColorBrush x:Key="ArtVignetteStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="ArtHeroShadeDeepColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="ArtHeroShadeStrongColor" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="ArtHeroShadeSoftColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="DrawerMaskBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.8" />
            <SolidColorBrush x:Key="LaunchSettingsMaskBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.75" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="GlassBlurSigmaPill">12</x:Double>
    <x:Double x:Key="GlassBlurSigmaIsland">22</x:Double>
    <x:Double x:Key="GlassBlurSigmaOverlay">32</x:Double>
    <x:Double x:Key="GlassSaturation">1.22</x:Double>
    <x:Double x:Key="GlassBrightness">1.04</x:Double>
    <x:Double x:Key="MotionScrimFloor">0.28</x:Double>
    <x:Double x:Key="LocalScrimReferenceAlpha">0.34</x:Double>

    <SolidColorBrush x:Key="DrawerMaskBrush" Color="#72241E1B" />
    <SolidColorBrush x:Key="LaunchSettingsMaskBrush" Color="#66241E1B" />

</ResourceDictionary>
