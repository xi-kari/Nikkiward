<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared control states and named launcher control styles. -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="DerivedAccentBrush" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FF2A2320" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#592A2320"/>

            <SolidColorBrush x:Key="TextControlBackground" Color="#FFEDE5DA"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFF2EBE1"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFDFAF5"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF9A8C82"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF9A8C82"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A2A2320"/>

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFEDE5DA"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFF2EBE1"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FFE5DCD0"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1A2A2320"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFDFAF5"/>
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1A2A2320"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FFEDE5DA"/>

            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF2A2320"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF6B5F57"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF2A2320"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="FocusVisualPrimaryBrush" ResourceKey="DerivedAccentBrush" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#FFF5EFE8" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#59F5EFE8"/>

            <SolidColorBrush x:Key="TextControlBackground" Color="#FF1A1512"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FF221C19"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FF2F2825"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF8A7D74"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#FF8A7D74"/>
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1FF5EFE8"/>

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF1A1512"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF221C19"/>
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#FF161110"/>
            <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#1FF5EFE8"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FF2F2825"/>
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#1FF5EFE8"/>
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#FF3A322E"/>

            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFF5EFE8"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFBFB2A8"/>
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FFF5EFE8"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="TextControlBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextControlForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="{ThemeResource SystemColorButtonTextColor}" />

            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SliderTickBarFill" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <Thickness x:Key="FocusVisualPrimaryThickness">1.5</Thickness>
    <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>
    <Thickness x:Key="FocusVisualPrimaryMargin">-2</Thickness>
    <Thickness x:Key="FocusVisualSecondaryMargin">-4</Thickness>

    <!-- Neutral button states for paper and glass surfaces. -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F9A8C82"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#2E9A8C82"/>
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#4DC9B8A6"/>
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#33C9B8A6"/>
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1AC9B8A6"/>

    <!-- Accent button states: the blush primary action. -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFEFB0C1"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFD98CA2"/>
    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#40E8A0B4"/>
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF2A2320"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF2A2320"/>
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF2A2320"/>
    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#592A2320"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent"/>
    <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="Transparent"/>

    <!-- Focus underline for text input. -->
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#66E8A0B4"/>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0,0,0,2</Thickness>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#FFE8A0B4"/>

    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#66E8A0B4"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#40E8A0B4"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#59E8A0B4"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#73E8A0B4"/>

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFEFB0C1"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFD98CA2"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#40E8A0B4"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#339A8C82"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#479A8C82"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#5C9A8C82"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#4D9A8C82"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="Transparent"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF2A2320"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF9A8C82"/>

    <CornerRadius x:Key="CheckBoxCornerRadius">4</CornerRadius>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFEFB0C1"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFD98CA2"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="#40E8A0B4"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#1F9A8C82"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#669A8C82"/>
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#8C9A8C82"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF2A2320"/>
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FF2A2320"/>

    <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFE8A0B4"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFEFB0C1"/>
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFD98CA2"/>
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#40E8A0B4"/>
    <SolidColorBrush x:Key="SliderTrackFill" Color="#339A8C82"/>
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#479A8C82"/>
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#479A8C82"/>
    <SolidColorBrush x:Key="SliderTickBarFill" Color="#669A8C82"/>

    <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="56"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusAction}"/>
        <Setter Property="Padding" Value="32,0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource DerivedAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkOnAccentBrush}"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource DerivedAccentBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkOnAccentBrush}"/>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="24,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource AccentClayBrush}"/>
        <Setter Property="Foreground" Value="#FFFDF7F0"/>
    </Style>

    <Style x:Key="GlassButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{ThemeResource GlassPillBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource IslandEdgeHighlightBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
    </Style>

    <Style x:Key="SubtleButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
    </Style>

    <Style x:Key="ReadOnlyOnArtTextBoxStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{ThemeResource PaperRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineSoftBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtSecondaryTextBrush}" />
    </Style>

    <Style
        x:Key="ReadOnlyMonospaceTextBoxStyle"
        BasedOn="{StaticResource ReadOnlyOnArtTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style
        x:Key="EditableMonospaceTextBoxStyle"
        BasedOn="{StaticResource ReadOnlyMonospaceTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
    </Style>

    <Style x:Key="OnArtGlassButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{ThemeResource GlassPillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    </Style>

    <Style
        x:Key="PrimaryActionButtonStyle"
        BasedOn="{StaticResource OnArtGlassButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="Background" Value="{ThemeResource PrimaryActionFillBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource InkOnAccentBrush}" />
    </Style>

    <Style x:Key="OnArtIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="MinHeight" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Background" Value="{ThemeResource PaperSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineSoftBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="MinHeight" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Background" Value="{ThemeResource PaperSunkenBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource HairlineSoftBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ToggleSwitch">
        <Setter Property="MinHeight" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="{ThemeResource ControlHeight}"/>
        <Setter Property="FontFamily" Value="{ThemeResource UIFontFamily}"/>
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
