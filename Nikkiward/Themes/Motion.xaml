<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Motion tokens for Nikkiward. Durations, easing curves, interaction scales. -->
    <!-- Spacing/geometry/color live in their own dictionaries; nothing here is theme varying. -->

    <!--
        DURATIONS
        MotionMicro    state flickers: hover tint, ripple, checkbox
        MotionStandard default control transitions
        MotionSurface  islands, panes, sheets sliding in
        MotionArt      hero art crossfade, parallax settle
    -->
    <Duration x:Key="MotionMicro">0:0:0.12</Duration>
    <Duration x:Key="MotionStandard">0:0:0.2</Duration>
    <Duration x:Key="MotionSurface">0:0:0.32</Duration>
    <Duration x:Key="MotionArt">0:0:0.48</Duration>
    <x:Double x:Key="MotionStateDuration">180</x:Double>
    <x:Double x:Key="MotionPanelOpen">280</x:Double>
    <x:Double x:Key="MotionPanelClose">180</x:Double>

    <!--
        EASING, FORM 1: KeySpline resources for XAML storyboards.

        Consumed by spline key frames, e.g.
            <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1"
                                  KeySpline="{StaticResource MotionDecelerate}" />

        Written with explicit ControlPoint1 / ControlPoint2 attributes on purpose.
        The WPF style initialization string "0.1,0.9 0.2,1.0" as element content
        relies on a KeySpline type converter that WinUI 3 does not document, so the
        attribute form is the safe spelling. Point attributes DO have a converter.

        CAVEAT: KeySpline is a DependencyObject, not a frozen value type. Handing the
        same instance to more than one key frame can throw at parse time. Reuse these
        for one storyboard each, or prefer FORM 2 below for anything shared or repeated.
    -->
    <KeySpline x:Key="MotionDecelerate" ControlPoint1="0.1,0.9" ControlPoint2="0.2,1.0" />
    <KeySpline x:Key="MotionEmphasis" ControlPoint1="0.16,1.0" ControlPoint2="0.3,1.0" />

    <!--
        EASING, FORM 2: raw control points for code built easing functions.
        This is the recommended path for animations composed in C#, and the
        fallback if a KeySpline resource ever misbehaves at parse time.

            var ease = new CubicBezierEasingFunction
            {
                ControlPoint1 = new Vector2(
                    (float)(double)Application.Current.Resources["MotionDecelerateX1"],
                    (float)(double)Application.Current.Resources["MotionDecelerateY1"]),
                ControlPoint2 = new Vector2(
                    (float)(double)Application.Current.Resources["MotionDecelerateX2"],
                    (float)(double)Application.Current.Resources["MotionDecelerateY2"]),
            };

        For a Storyboard in code, the same four numbers feed a fresh KeySpline:
            new KeySpline { ControlPoint1 = new Point(x1, y1), ControlPoint2 = new Point(x2, y2) }
    -->

    <!-- Decelerate: fast out, long soft landing. Entrances, expands, reveals. -->
    <x:Double x:Key="MotionDecelerateX1">0.1</x:Double>
    <x:Double x:Key="MotionDecelerateY1">0.9</x:Double>
    <x:Double x:Key="MotionDecelerateX2">0.2</x:Double>
    <x:Double x:Key="MotionDecelerateY2">1.0</x:Double>

    <!-- Emphasis: sharper attack, near instant settle. Selection, commits, page swaps. -->
    <x:Double x:Key="MotionEmphasisX1">0.16</x:Double>
    <x:Double x:Key="MotionEmphasisY1">1.0</x:Double>
    <x:Double x:Key="MotionEmphasisX2">0.3</x:Double>
    <x:Double x:Key="MotionEmphasisY2">1.0</x:Double>

    <x:Double x:Key="EaseGlassX1">0.16</x:Double>
    <x:Double x:Key="EaseGlassY1">1.0</x:Double>
    <x:Double x:Key="EaseGlassX2">0.3</x:Double>
    <x:Double x:Key="EaseGlassY2">1.0</x:Double>

    <!--
        INTERACTION SCALES
        HoverScale       art cards and cover tiles lifting under the cursor
        PressScale       pointer pressed settle, applies to the same art cards
        ButtonHoverScale restrained lift for text buttons and chips
        ParallaxAmplitude max pixel offset for masthead art drift, either axis
    -->
    <x:Double x:Key="HoverScale">1.06</x:Double>
    <x:Double x:Key="PressScale">0.98</x:Double>
    <x:Double x:Key="ButtonHoverScale">1.02</x:Double>
    <x:Double x:Key="ParallaxAmplitude">10</x:Double>

</ResourceDictionary>
