<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography tokens for Nikkiward. Font stacks first, then the 8 TextBlock
         styles. Serif stack is reserved for the Display and Stat styles only.
         All FontFamily lookups are StaticResource because the families are
         declared in this same dictionary. Foreground uses ThemeResource so live
         theme switching repaints the ink. -->

    <FontFamily x:Key="DisplayFontFamilySerif">Source Han Serif SC, Noto Serif SC, Songti SC, SimSun, serif</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Source Han Serif SC, Noto Serif SC, Songti SC, SimSun, serif</FontFamily>
    <FontFamily x:Key="UIFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, monospace</FontFamily>

    <!-- Display tier. TrimToCapHeight plus TrimSideBearings removes the CJK
         ideographic ascent/descent padding that otherwise leaves the masthead
         floating inside its own line box. -->

    <Style x:Key="MastheadDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="58" />
        <Setter Property="CharacterSpacing" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="PageTitleDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionTitleDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Tabular numerals keep stat rows from shifting horizontally as values
         change. The serif stack carries the figures for the fashion-book feel. -->
    <Style x:Key="StatNumberDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="46" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- UI tier. Sans stack, full line bounds so mixed CJK and Latin runs in
         body copy keep their diacritics and ideographic descenders intact. -->

    <Style x:Key="BodyUI" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyStrongUI" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionUI" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Wide tracking reads as a small-caps field label without needing a
         separate font. NoWrap because labels sit above single controls. -->
    <Style x:Key="FieldLabelUI" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UIFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource InkSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OnArtFieldLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtTertiaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OnArtSectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="OnArtBodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource OnArtSecondaryTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
