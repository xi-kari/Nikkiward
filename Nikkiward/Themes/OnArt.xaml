<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Artwork luminance selects the matching text and scrim polarity. -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ===================== LIGHT: bright artwork ===================== -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="OnArtPrimaryTextBrush" Color="#FF241E1B" />
            <SolidColorBrush x:Key="OnArtSecondaryTextBrush" Color="#E62A2320" />
            <SolidColorBrush x:Key="OnArtTertiaryTextBrush" Color="#BF3F3630" />

            <!-- Warm near white wash. Element Opacity carries the strength. -->
            <SolidColorBrush x:Key="OnArtScrimBrush" Color="#FFFDFAF5" />

            <LinearGradientBrush x:Key="LocalScrimBottomBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00FDFAF5" />
                <GradientStop Offset="0.45" Color="#42FDFAF5" />
                <GradientStop Offset="1" Color="#B8FDFAF5" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LocalScrimTopBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#A8FDFAF5" />
                <GradientStop Offset="0.55" Color="#38FDFAF5" />
                <GradientStop Offset="1" Color="#00FDFAF5" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="LocalScrimRadialBrush" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Offset="0" Color="#00FDFAF5" />
                <GradientStop Offset="1" Color="#9CFDFAF5" />
            </RadialGradientBrush>

            <!-- Gradient endpoints share RGB so interpolation changes alpha only. -->
            <Color x:Key="OnArtScrimColor">#FFFDFAF5</Color>
            <Color x:Key="OnArtScrimTransparentColor">#00FDFAF5</Color>

            <!-- Backing plates for on art controls that have no fill of their own. -->
            <SolidColorBrush x:Key="OnArtPlateBrush" Color="#99FDFAF5" />
            <SolidColorBrush x:Key="OnArtPlateStrongBrush" Color="#E6FDFAF5" />

            <SolidColorBrush x:Key="OnArtStrokeBrush" Color="#33241E1B" />

            <SolidColorBrush x:Key="AuthorCardSurfaceBrush" Color="#B8E7E2EB" />
            <LinearGradientBrush x:Key="AuthorCardImageTintBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#8AF6F1EA" />
                <GradientStop Offset="0.46" Color="#18F6F1EA" />
                <GradientStop Offset="1" Color="#7AF6F1EA" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AuthorCardBottomScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00F6F1EA" />
                <GradientStop Offset="0.5" Color="#38F6F1EA" />
                <GradientStop Offset="1" Color="#B8F6F1EA" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AuthorCardEdgeBrush" Color="#663E3546" />
            <SolidColorBrush x:Key="AuthorCardInnerRingBrush" Color="#24332D3A" />
            <SolidColorBrush x:Key="AuthorCardTitleBrush" Color="#FF332D3A" />
            <SolidColorBrush x:Key="AuthorCardMetaBrush" Color="#FF746B79" />
            <SolidColorBrush x:Key="AuthorCardPanelBrush" Color="#CFF8F4F1" />
            <SolidColorBrush x:Key="AuthorCardPanelEdgeBrush" Color="#663E3546" />
            <SolidColorBrush x:Key="AuthorCardTagBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AuthorCardTagTextBrush" Color="#FF332D3A" />

        </ResourceDictionary>

        <!-- ====================== DARK: dark artwork ====================== -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="OnArtPrimaryTextBrush" Color="#FFF7F2EA" />
            <SolidColorBrush x:Key="OnArtSecondaryTextBrush" Color="#E6EFE7DD" />
            <SolidColorBrush x:Key="OnArtTertiaryTextBrush" Color="#BFDED3C7" />

            <SolidColorBrush x:Key="OnArtScrimBrush" Color="#FF241E1B" />

            <LinearGradientBrush x:Key="LocalScrimBottomBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00241E1B" />
                <GradientStop Offset="0.45" Color="#42241E1B" />
                <GradientStop Offset="1" Color="#B8241E1B" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LocalScrimTopBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#A8241E1B" />
                <GradientStop Offset="0.55" Color="#38241E1B" />
                <GradientStop Offset="1" Color="#00241E1B" />
            </LinearGradientBrush>
            <RadialGradientBrush x:Key="LocalScrimRadialBrush" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Offset="0" Color="#00241E1B" />
                <GradientStop Offset="1" Color="#9C241E1B" />
            </RadialGradientBrush>

            <Color x:Key="OnArtScrimColor">#FF241E1B</Color>
            <Color x:Key="OnArtScrimTransparentColor">#00241E1B</Color>

            <SolidColorBrush x:Key="OnArtPlateBrush" Color="#99241E1B" />
            <SolidColorBrush x:Key="OnArtPlateStrongBrush" Color="#E6241E1B" />

            <SolidColorBrush x:Key="OnArtStrokeBrush" Color="#33F7F2EA" />

            <SolidColorBrush x:Key="AuthorCardSurfaceBrush" Color="#B8211D26" />
            <LinearGradientBrush x:Key="AuthorCardImageTintBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#321F1B25" />
                <GradientStop Offset="0.46" Color="#001F1B25" />
                <GradientStop Offset="1" Color="#7A211D26" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AuthorCardBottomScrimBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Offset="0" Color="#00211D26" />
                <GradientStop Offset="0.5" Color="#38211D26" />
                <GradientStop Offset="1" Color="#B8211D26" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AuthorCardEdgeBrush" Color="#66E7D9ED" />
            <SolidColorBrush x:Key="AuthorCardInnerRingBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AuthorCardTitleBrush" Color="#FFF8F1F6" />
            <SolidColorBrush x:Key="AuthorCardMetaBrush" Color="#D1C8BBC8" />
            <SolidColorBrush x:Key="AuthorCardPanelBrush" Color="#B82F2937" />
            <SolidColorBrush x:Key="AuthorCardPanelEdgeBrush" Color="#66E7D9ED" />
            <SolidColorBrush x:Key="AuthorCardTagBrush" Color="#42FFFFFF" />
            <SolidColorBrush x:Key="AuthorCardTagTextBrush" Color="#FFF8F1F6" />

        </ResourceDictionary>

        <!-- ========================= HIGH CONTRAST ========================= -->
        <ResourceDictionary x:Key="HighContrast">

            <SolidColorBrush x:Key="OnArtPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnArtSecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OnArtTertiaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="OnArtScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LocalScrimBottomBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LocalScrimTopBrush" Color="Transparent" />
            <SolidColorBrush x:Key="LocalScrimRadialBrush" Color="Transparent" />

            <!-- The edge scrim is redundant over opaque high-contrast plates. -->
            <Color x:Key="OnArtScrimColor">#00000000</Color>
            <Color x:Key="OnArtScrimTransparentColor">#00000000</Color>

            <SolidColorBrush x:Key="OnArtPlateBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OnArtPlateStrongBrush" Color="{ThemeResource SystemColorWindowColor}" />

            <SolidColorBrush x:Key="OnArtStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="AuthorCardSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AuthorCardImageTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AuthorCardBottomScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AuthorCardEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AuthorCardInnerRingBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AuthorCardTitleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AuthorCardMetaBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AuthorCardPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AuthorCardPanelEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AuthorCardTagBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="AuthorCardTagTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <StaticResource x:Key="OnArtBadgeFillBrush" ResourceKey="DerivedAccentBrush" />
    <StaticResource x:Key="OnArtStatusIndicatorBrush" ResourceKey="AccentMintBrush" />

</ResourceDictionary>
