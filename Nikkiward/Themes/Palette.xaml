<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Nikkiward palette. Warm light first: paper base, warm ink, warm shadow.
         Dark is warm charcoal (R greater than B), never blue black.
         No Fluent default blue anywhere, no pure black or white surfaces. -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- LIGHT: paper stack plus warm ink -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="PaperBaseColor">#FFF6F1EA</Color>
            <SolidColorBrush x:Key="PaperBaseBrush" Color="#FFF6F1EA" />
            <SolidColorBrush x:Key="PaperRaisedBrush" Color="#FFFDFAF5" />
            <SolidColorBrush x:Key="PaperSunkenBrush" Color="#FFEDE5DA" />

            <SolidColorBrush x:Key="InkPrimaryBrush" Color="#FF2A2320" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="#FF6B5F57" />
            <SolidColorBrush x:Key="InkTertiaryBrush" Color="#FF9A8C82" />

            <SolidColorBrush x:Key="HairlineSoftBrush" Color="#1A2A2320" />

            <!-- Warm dark ink is the legible mark on blush, gold, mint, lilac and clay. -->
            <SolidColorBrush x:Key="InkOnAccentBrush" Color="#FF2A2320" />

            <SolidColorBrush x:Key="ScrimBrush" Color="#33000000" />
        </ResourceDictionary>

        <!-- DARK: warm charcoal, red channel above blue -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="PaperBaseColor">#FF241E1B</Color>
            <SolidColorBrush x:Key="PaperBaseBrush" Color="#FF241E1B" />
            <SolidColorBrush x:Key="PaperRaisedBrush" Color="#FF2F2825" />
            <SolidColorBrush x:Key="PaperSunkenBrush" Color="#FF1A1512" />

            <SolidColorBrush x:Key="InkPrimaryBrush" Color="#FFF5EFE8" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="#FFBFB2A8" />
            <SolidColorBrush x:Key="InkTertiaryBrush" Color="#FF8A7D74" />

            <SolidColorBrush x:Key="HairlineSoftBrush" Color="#1FF5EFE8" />

            <!-- Accents keep their light value in dark, so the ink on them stays dark. -->
            <SolidColorBrush x:Key="InkOnAccentBrush" Color="#FF2A2320" />

            <SolidColorBrush x:Key="ScrimBrush" Color="#4D000000" />
        </ResourceDictionary>

        <!-- HIGHCONTRAST: defer to real system colors so user settings win.
             Paper and ink map onto the window and window text pair; the sunken
             layer uses the system alt surface so depth survives without color. -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="PaperBaseColor" ResourceKey="SystemColorWindowColor" />
            <SolidColorBrush x:Key="PaperBaseBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperRaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperSunkenBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />

            <SolidColorBrush x:Key="InkPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InkSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="InkTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />

            <SolidColorBrush x:Key="HairlineSoftBrush" Color="{ThemeResource SystemColorWindowTextColor}" />

            <SolidColorBrush x:Key="InkOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />

            <SolidColorBrush x:Key="ScrimBrush" Color="{ThemeResource SystemColorWindowColor}" Opacity="0.7" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Brand accents are theme invariant by design: the same five pigments read
         on paper and on warm charcoal, so a chip keeps its identity across themes. -->
    <SolidColorBrush x:Key="AccentBlushBrush" Color="#FFE8A0B4" />
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#FFD9A657" />
    <SolidColorBrush x:Key="AccentMintBrush" Color="#FF8FC9B8" />
    <SolidColorBrush x:Key="AccentLilacBrush" Color="#FFB9A6DA" />
    <SolidColorBrush x:Key="AccentClayBrush" Color="#FFC77B62" />
    <SolidColorBrush x:Key="JournalPaperBrush" Color="#F7F0E4D3" />

    <!-- Runtime overridable by ArtBackdropService, which mutates this brush
         instance's Color rather than replacing the dictionary entry. Replacing
         the entry does not refresh references XAML has already resolved, so
         in place mutation is the only reliable path. It lives outside
         ThemeDictionaries on purpose: one brush covers both themes, and app
         level resources are not reshuffled on theme change. Initial value is
         AccentBlush, which is also the contrast fallback. -->
    <SolidColorBrush x:Key="DerivedAccentBrush" Color="#FFE8A0B4" />

    <SolidColorBrush x:Key="PrimaryActionSolidBrush" Color="#FFE8A0B4" />

</ResourceDictionary>
