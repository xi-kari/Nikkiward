<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Nikkiward.Features.Shell.HomeNavigation">
    <ScrollViewer
        ViewChanged="OnNavigationScrolled"
        HorizontalScrollMode="Auto"
        HorizontalScrollBarVisibility="Hidden"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Items" Orientation="Horizontal" Spacing="0" Padding="16,0">
            <ContentPresenter x:Name="Brand" Content="Nikkiward" VerticalAlignment="Center" />
            <RadioButton GroupName="ShellDestination" Tag="launcher" Content="启动" MinWidth="0" Click="OnClick" />
            <RadioButton GroupName="ShellDestination" Tag="library" Content="手账" MinWidth="0" Click="OnClick" />
            <RadioButton GroupName="ShellDestination" Tag="gallery" Content="相册" MinWidth="0" Click="OnClick" />
            <RadioButton
                GroupName="ShellDestination"
                Tag="gallery-favorites"
                Content="收藏"
                MinWidth="0"
                Click="OnClick" />
            <RadioButton GroupName="ShellDestination" Tag="resonance" Content="共鸣" MinWidth="0" Click="OnClick" />
            <RadioButton
                GroupName="ShellDestination"
                x:Name="PhotoPluginNavigationItem"
                Tag="photo-plugin"
                Content="相册插件"
                MinWidth="0"
                Click="OnClick"
                Visibility="Collapsed" />
            <RadioButton GroupName="ShellDestination" Tag="settings" Content="设置" MinWidth="0" Click="OnClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
