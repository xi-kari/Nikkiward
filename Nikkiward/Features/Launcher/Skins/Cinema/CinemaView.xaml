<UserControl x:Class="Nikkiward.Features.Launcher.Skins.CinemaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{x:Bind Background, Mode=OneWay}" Padding="24,54,24,20" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Body" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <TextBlock x:Name="Heading" Text="安全模式" FontSize="30" TextLineBounds="Full" OpticalMarginAlignment="None" />
            <TextBlock Text="新界面未能载入。请确认 Microsoft Edge WebView2 运行时已安装且可用。" TextWrapping="Wrap" />
            <Expander Header="技术详情" HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding HomeFallback}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Expander>
            <Button Content="{Binding ProfileDisplayName}" AutomationProperties.Name="切换档案" Click="OnProfilesClicked" />
            <TextBlock Text="{Binding HomeLaunchConclusion}" TextWrapping="Wrap" />
            <Button Style="{StaticResource AccentButtonStyle}" Content="{Binding HomeLaunchLabel}" IsEnabled="{Binding HomeLaunchEnabled}" Click="OnLaunch" />
            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="108" ItemHeight="46">
                <Button Content="定位游戏" Tag="locate" IsEnabled="{Binding CanDiscover}" Click="OnCommand" />
                <Button Content="重新检查" Tag="recheck" IsEnabled="{Binding CanRefresh}" Click="OnCommand" />
                <Button Content="重试新界面" Click="OnRetry" />
            </VariableSizedWrapGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
