<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Nikkiward.ViewModels"
    xmlns:skin="using:Nikkiward.Features.Launcher.Skins"
    x:Class="Nikkiward.Features.Launcher.Skins.CinemaView"
    x:DefaultBindMode="OneWay"
    FontFamily="{ThemeResource HomeTitleFont}"
    Foreground="{ThemeResource HomeInkBrush}"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <Style x:Key="ColumnButton" TargetType="skin:HomeButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{ThemeResource HomeInkBrush}" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value=".78" />
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border x:Name="TopScrim" Height="120" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{ThemeResource CinemaTopScrim}" />
        <Border
            x:Name="IdlePlate"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Left"
            Margin="32" MinWidth="216"
            Padding="18,14,18,13"
            Shadow="{ThemeResource HomeElevation}"
            Background="{ThemeResource HomeSurfaceBrush}"
            CornerRadius="2"
            Visibility="Collapsed">
            <StackPanel Spacing="5">
                <TextBlock Text="{x:Bind Model.HomeArtName}" FontSize="19" CharacterSpacing="100" />
                <TextBlock Text="{x:Bind Model.HomeArtSource}" Style="{StaticResource Caption}" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="Exhibit" VerticalAlignment="Bottom" Spacing="16">
            <StackPanel x:Name="Recent" Orientation="Horizontal" Margin="32,0" Spacing="6" Visibility="Collapsed">
                <skin:HomeButton
                    Tag="gallery"
                    Width="96" Padding="12,10" CornerRadius="2" BorderThickness="0"
                    HorizontalContentAlignment="Left" AutomationProperties.Name="最近拍摄，全部照片"
                    Height="60"
                    Background="{ThemeResource HomeSurfaceBrush}" Foreground="{ThemeResource HomeInkBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="最近拍摄" FontSize="12" />
                        <TextBlock Text="全部照片" Style="{StaticResource Caption}" />
                    </StackPanel>
                </skin:HomeButton>
                <ItemsControl x:Name="Photos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryPhotoItemViewModel">
                            <skin:HomeButton
                                Tag="photo"
                                Width="96"
                                Height="60"
                                Padding="0"
                                AutomationProperties.Name="{x:Bind FileName}">
                                <Image Source="{x:Bind ThumbnailSource}" Stretch="UniformToFill" />
                            </skin:HomeButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Grid
                x:Name="Band"
                MinHeight="116"
                Background="{ThemeResource HomeSurfaceBrush}"
                Padding="32,0"
                ColumnSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="Facts" Orientation="Horizontal" Spacing="36" Margin="0,18,0,0" VerticalAlignment="Top">
                    <StackPanel x:Name="Art" VerticalAlignment="Top">
                        <TextBlock
                            x:Name="ArtLabel" Height="16" CharacterSpacing="140"
                            Style="{StaticResource Caption}"
                            Text="{x:Bind Model.HomeArtSource}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock
                                x:Name="ArtTitle"
                                Text="{x:Bind Model.HomeArtName}"
                                FontFamily="{ThemeResource HomeTitleFont}"
                                FontSize="30" FontWeight="Light" CharacterSpacing="80"
                                MaxWidth="132"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <skin:HomeButton
                                Tag="background" Width="28" Height="28" HorizontalContentAlignment="Center"
                                Style="{StaticResource ColumnButton}"
                                AutomationProperties.Name="设置背景"
                                ToolTipService.ToolTip="设置背景">
                                <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                            </skin:HomeButton>
                            <skin:HomeButton
                                Tag="reset" Width="28" Height="28" HorizontalContentAlignment="Center"
                                Style="{StaticResource ColumnButton}"
                                AutomationProperties.Name="恢复默认背景"
                                ToolTipService.ToolTip="恢复默认背景">
                                <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                            </skin:HomeButton>
                        </StackPanel>
                    </StackPanel>
                    <skin:HomeButton
                        x:Name="ProfileColumn"
                        Tag="profile"
                        Style="{StaticResource ColumnButton}" VerticalAlignment="Top"
                        AutomationProperties.Name="切换档案">
                        <StackPanel Spacing="2">
                            <TextBlock Text="档案" Height="16" CharacterSpacing="140" Style="{StaticResource Caption}" />
                            <TextBlock
                                Text="{x:Bind Model.ProfileDisplayName}"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource Value}" Height="42" Padding="0,10,0,0" />
                            <TextBlock Text="{x:Bind Model.ChannelText}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </skin:HomeButton>
                    <skin:HomeButton
                        x:Name="CheckColumn"
                        Tag="status"
                        Style="{StaticResource ColumnButton}" VerticalAlignment="Top"
                        AutomationProperties.Name="查看诊断">
                        <StackPanel Spacing="2">
                            <TextBlock Text="启动检查" Height="16" CharacterSpacing="140" Style="{StaticResource Caption}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Height="42">
                                <Grid Width="7" Height="7" VerticalAlignment="Center">
                                    <Ellipse x:Name="ReadyDot" Fill="{ThemeResource CinemaReadyBrush}" />
                                    <Ellipse x:Name="WarnDot" Fill="{ThemeResource CinemaWarningBrush}" />
                                    <Ellipse x:Name="NeutralDot" Fill="{ThemeResource HomeStrokeBrush}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Model.HomeCheckText}" Style="{StaticResource Value}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock
                                x:Name="CheckTime"
                                Text="{x:Bind Model.HomeCheckTime}"
                                MaxWidth="144"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource Caption}" />
                        </StackPanel>
                    </skin:HomeButton>
                    <skin:HomeButton x:Name="Time" Tag="journal" VerticalAlignment="Top" Style="{StaticResource ColumnButton}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="官方手账时长" Height="16" CharacterSpacing="140" Style="{StaticResource Caption}" />
                            <TextBlock Text="{x:Bind Model.OfficialJournalDuration}" Style="{StaticResource Value}" Height="42" Padding="0,10,0,0" />
                            <TextBlock
                                Visibility="{x:Bind Model.HomeLocalTimeVisibility}"
                                Text="{x:Bind Model.LocalPlayDuration}"
                                Style="{StaticResource Caption}" />
                        </StackPanel>
                    </skin:HomeButton>
                    <StackPanel x:Name="TaskColumn" VerticalAlignment="Top" Spacing="2">
                        <TextBlock Text="后台任务" Height="16" CharacterSpacing="140" Style="{StaticResource Caption}" />
                        <TextBlock Text="{x:Bind Model.HomeTaskText}" Style="{StaticResource Value}" Height="42" Padding="0,10,0,0" />
                        <ProgressBar
                            Visibility="{x:Bind Model.ChannelStoreProgressVisibility}"
                            Value="{x:Bind Model.ChannelStoreProgressPercent}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="Reason" Grid.Column="1" MaxWidth="430" Margin="12,4,20,4"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"
                           Text="{x:Bind Model.HomeLaunchDetail}" TextWrapping="Wrap" FontSize="12" LineHeight="18" />
                <StackPanel
                    x:Name="Actions"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <skin:HomeButton
                        Tag="settings"
                        Width="48"
                        Height="64" CornerRadius="4"
                        AutomationProperties.Name="游戏设置"
                        ToolTipService.ToolTip="游戏设置">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </skin:HomeButton>
                    <skin:HomeButton
                        x:Name="Launch"
                        Tag="launch"
                        MinWidth="190"
                        Height="64"
                        Padding="22,0,18,0"
                        FontSize="20"
                        CornerRadius="{ThemeResource HomeRadius}"
                        Background="{ThemeResource HomeInkBrush}"
                        Foreground="{ThemeResource HomeSurfaceBrush}"
                        BorderBrush="{ThemeResource HomeStrokeBrush}"
                        IsEnabled="{x:Bind Model.HomeLaunchEnabled}"
                        AutomationProperties.Name="{x:Bind Model.HomeLaunchLabel}"
                        AutomationProperties.HelpText="{x:Bind Model.HomeLaunchDetail}"
                        ToolTipService.ToolTip="{x:Bind Model.HomeLaunchDetail}">
                        <skin:HomeButton.Template>
                            <ControlTemplate TargetType="skin:HomeButton">
                                <Grid>
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Target="HoverLine.Opacity" Value="1" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Opacity" Value=".8" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <VisualState.Setters>
                                                    <Setter Target="Plate.Background" Value="Transparent" />
                                                    <Setter
                                                        Target="Presenter.Foreground"
                                                        Value="{ThemeResource HomeInkBrush}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Border
                                        x:Name="Plate"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                    <ContentPresenter
                                        x:Name="Presenter"
                                        Content="{TemplateBinding Content}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Margin="{TemplateBinding Padding}" HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                    <Border
                                        x:Name="HoverLine"
                                        Height="3"
                                        Opacity="0"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource DerivedAccentBrush}" />
                                </Grid>
                            </ControlTemplate>
                        </skin:HomeButton.Template>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon x:Name="Play" Glyph="&#x25B6;" FontFamily="Segoe UI Symbol" FontSize="16" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind Model.HomeBusy}"
                                Visibility="{x:Bind Model.HomeBusy}" />
                            <TextBlock x:Name="LaunchLabel" Text="{x:Bind Model.HomeLaunchLabel}" FontSize="20" FontWeight="SemiBold" CharacterSpacing="120" />
                        </StackPanel>
                    </skin:HomeButton>
                    <skin:HomeButton
                        Tag="close"
                        Height="64"
                        Content="{x:Bind Model.CloseGameButtonLabel}"
                        Visibility="{x:Bind Model.HomeCloseVisibility}"
                        IsEnabled="{x:Bind Model.HomeCloseEnabled}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
