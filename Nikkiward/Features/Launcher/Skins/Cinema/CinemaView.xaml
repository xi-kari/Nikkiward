<UserControl
    x:Class="Nikkiward.Features.Launcher.Skins.CinemaView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource PaperBaseBrush}" Padding="32">
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="安全模式" Style="{StaticResource PageTitleDisplay}" />
            <TextBlock Text="{Binding HomeFallback}" TextWrapping="Wrap" />
            <Button Content="{Binding ProfileDisplayName}" AutomationProperties.Name="切换档案" Click="OnProfilesClicked" />
            <TextBlock Text="{Binding HomeLaunchDetail}" TextWrapping="Wrap" />
            <Button Content="{Binding HomeLaunchLabel}" IsEnabled="{Binding HomeLaunchEnabled}" Click="OnLaunch" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="定位游戏" Tag="locate" IsEnabled="{Binding CanDiscover}" Click="OnCommand" />
                <Button Content="重新检查" Tag="recheck" IsEnabled="{Binding CanRefresh}" Click="OnCommand" />
                <Button Content="重试新界面" Click="OnRetry" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
