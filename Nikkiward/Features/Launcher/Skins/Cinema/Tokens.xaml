<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="CinemaTopScrim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#C7F8F4F1" />
                <GradientStop Offset=".45" Color="#6BF8F4F1" />
                <GradientStop Offset="1" Color="#00F8F4F1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CinemaReadyBrush" Color="#1A7448" />
            <SolidColorBrush x:Key="CinemaWarningBrush" Color="#9A4A08" />
            <SolidColorBrush x:Key="HomeSurfaceBrush" Color="#FFF8F4F1" />
            <SolidColorBrush x:Key="HomeInkBrush" Color="#FF1B1418" />
            <SolidColorBrush x:Key="HomeStrokeBrush" Color="#FFAAA69F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="CinemaTopScrim" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#C707090F" />
                <GradientStop Offset=".45" Color="#6B07090F" />
                <GradientStop Offset="1" Color="#0007090F" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CinemaReadyBrush" Color="#86E0B0" />
            <SolidColorBrush x:Key="CinemaWarningBrush" Color="#FFBF7A" />
            <SolidColorBrush x:Key="HomeSurfaceBrush" Color="#FF07090F" />
            <SolidColorBrush x:Key="HomeInkBrush" Color="#FFF3F5FA" />
            <SolidColorBrush x:Key="HomeStrokeBrush" Color="#FF666465" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CinemaTopScrim" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CinemaReadyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CinemaWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HomeInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HomeStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Thickness x:Key="HomeArtInset">0</Thickness>
    <CornerRadius x:Key="HomeArtRadius">0</CornerRadius>
    <FontFamily x:Key="HomeTitleFont">Manrope, Noto Sans SC, Microsoft YaHei UI, Segoe UI Variable</FontFamily>
    <DataTemplate x:Key="HomeBrandTemplate">
        <StackPanel Orientation="Horizontal" Spacing="9" Margin="4,0,22,0">
            <Border CornerRadius="5"><Image Source="/Assets/NikkiGameIcon.png" Width="20" Height="20" /></Border>
            <TextBlock Text="{Binding}" FontFamily="{ThemeResource HomeTitleFont}" FontSize="13" FontWeight="Bold" CharacterSpacing="20"
                       VerticalAlignment="Center" Foreground="{ThemeResource HomeInkBrush}" />
        </StackPanel>
    </DataTemplate>
    <CornerRadius x:Key="HomeRadius">4</CornerRadius>
    <ThemeShadow x:Key="HomeElevation" />
    <ControlTemplate x:Key="HomeNavTemplate" TargetType="RadioButton">
        <Grid Background="Transparent" Padding="13,0" Height="44">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Unchecked" />
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Rule.Opacity" Value="1" />
                            <Setter Target="Label.Opacity" Value="1" />
                            <Setter Target="Label.FontWeight" Value="SemiBold" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <TextBlock
                x:Name="Label" Opacity=".76"
                Text="{TemplateBinding Content}" FontSize="14" FontFamily="{ThemeResource HomeTitleFont}"
                VerticalAlignment="Center"
                Foreground="{ThemeResource HomeInkBrush}" />
            <Border
                x:Name="Rule"
                Background="{ThemeResource HomeInkBrush}"
                Height="1"
                Margin="0,0,0,9"
                VerticalAlignment="Bottom"
                Opacity="0" />
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
