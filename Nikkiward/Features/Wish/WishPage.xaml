<?xml version="1.0" encoding="utf-8"?>
<shell:PageBase
    x:Class="Nikkiward.Features.Wish.WishPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Nikkiward.Controls"
    xmlns:shell="using:Nikkiward.Features.Shell"
    xmlns:viewModels="using:Nikkiward.ViewModels"
    Background="{ThemeResource PaperBaseBrush}"
    KeyDown="OnKeyDown"
    NavigationCacheMode="Required">

    <Grid x:Name="RootGrid">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="960" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StatsWideGrid.Visibility" Value="Collapsed" />
                        <Setter Target="StatsCompactStack.Visibility" Value="Visible" />
                        <Setter Target="WishScrollContent.Padding" Value="24,0,20,24" />
                        <Setter Target="WishMonthScrollBar.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="WishMasthead"
            Margin="0,0,160,0"
            Padding="24,10,20,8"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource PageTitleDisplay}"
                Text="心愿记录" />
            <Button
                x:Name="WishLoginButton"
                Grid.Column="1"
                automation:AutomationProperties.Name="登录并同步心愿记录"
                Click="OnLoginClicked"
                Style="{StaticResource OnArtGlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE895;" />
                    <TextBlock VerticalAlignment="Center" Text="同步记录" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollView
                x:Name="WishHistoryScrollView"
                automation:AutomationProperties.Name="心愿记录内容"
                ContentOrientation="Vertical"
                ExtentChanged="OnWishScrollExtentChanged"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollBarVisibility="Hidden">
                <StackPanel
                    x:Name="WishScrollContent"
                    Padding="24,0,112,24"
                    Spacing="16">
                <TextBlock
                    x:Name="WishStatusText"
                    Style="{StaticResource CaptionUI}"
                    Text="尚未同步" />

                <controls:GlassIsland
                    x:Name="EmptyStateIsland"
                    automation:AutomationProperties.Name="心愿记录空状态">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{StaticResource BodyUI}"
                            Text="登录官方奇想手账后即可查看心愿记录。" />
                        <Button
                            HorizontalAlignment="Left"
                            automation:AutomationProperties.Name="登录并同步心愿记录"
                            Click="OnEmptyOpenClicked"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="同步记录" />
                    </StackPanel>
                </controls:GlassIsland>

                <StackPanel
                    x:Name="HistoryContent"
                    Spacing="16"
                    Visibility="Collapsed">
                    <controls:GlassIsland
                        x:Name="WardrobeSection"
                        automation:AutomationProperties.Name="我的共鸣衣橱"
                        Background="{ThemeResource PaperRaisedBrush}"
                        IslandCornerRadius="12">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource PageTitleDisplay}" Text="我的共鸣衣橱" />
                                    <TextBlock
                                        x:Name="WardrobeCountText"
                                        Style="{StaticResource CaptionUI}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentGoldBrush}"
                                    Style="{StaticResource FieldLabelUI}"
                                    Text="网页完整卡池" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ResonanceBanners}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="14" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="viewModels:ResonanceBannerCardViewModel"
                                        x:DefaultBindMode="OneTime">
                                        <Border
                                            MinHeight="250"
                                            automation:AutomationProperties.Name="{x:Bind AutomationName}"
                                            Background="{ThemeResource PaperSunkenBrush}"
                                            CornerRadius="14">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Image
                                                        Source="{x:Bind PreviewSource}"
                                                        Stretch="UniformToFill"
                                                        Visibility="{x:Bind ImageVisibility}" />
                                                    <Rectangle Fill="{ThemeResource ArtVignetteStrongBrush}" />
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="64"
                                                        Foreground="{ThemeResource AccentGoldBrush}"
                                                        Glyph="&#xE8B9;"
                                                        Visibility="{x:Bind PlaceholderVisibility}" />
                                                    <Border
                                                        Margin="14"
                                                        Padding="10,5"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom"
                                                        Background="{ThemeResource ScrimBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            Foreground="{ThemeResource OnArtPrimaryTextBrush}"
                                                            Style="{StaticResource SectionTitleDisplay}"
                                                            Text="{x:Bind CompletionText}"
                                                            TextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                                <Grid
                                                    Grid.Column="1"
                                                    Margin="0,14,16,14"
                                                    RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="3">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock
                                                                    Style="{StaticResource SectionTitleDisplay}"
                                                                    Text="{x:Bind OutfitTitle}" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource AccentGoldBrush}"
                                                                    Style="{StaticResource BodyStrongUI}"
                                                                    Text="{x:Bind RarityStars}" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="14">
                                                                <TextBlock Style="{StaticResource CaptionUI}" Text="平均共鸣次数" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource AccentClayBrush}"
                                                                    Style="{StaticResource BodyStrongUI}"
                                                                    Text="{x:Bind AveragePulls}" />
                                                                <TextBlock Style="{StaticResource CaptionUI}" Text="总计共鸣次数" />
                                                                <TextBlock
                                                                    Foreground="{ThemeResource AccentClayBrush}"
                                                                    Style="{StaticResource BodyStrongUI}"
                                                                    Text="{x:Bind TotalPulls}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="16,8"
                                                            Background="{ThemeResource AccentGoldBrush}"
                                                            CornerRadius="0,12,0,12">
                                                            <TextBlock
                                                                Foreground="{ThemeResource InkOnAccentBrush}"
                                                                Style="{StaticResource BodyStrongUI}"
                                                                Text="{x:Bind PatchTitle}" />
                                                        </Border>
                                                    </Grid>
                                                    <Rectangle
                                                        Grid.Row="1"
                                                        Height="1"
                                                        Fill="{ThemeResource HairlineSoftBrush}" />
                                                    <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind Slots}">
                                                        <ItemsRepeater.Layout>
                                                            <UniformGridLayout
                                                                MinColumnSpacing="8"
                                                                MinItemWidth="82"
                                                                MinRowSpacing="8" />
                                                        </ItemsRepeater.Layout>
                                                        <ItemsRepeater.ItemTemplate>
                                                            <DataTemplate
                                                                x:DataType="viewModels:ResonanceSlotCardViewModel"
                                                                x:DefaultBindMode="OneTime">
                                                                <Border
                                                                    MinHeight="86"
                                                                    automation:AutomationProperties.Name="{x:Bind Label}"
                                                                    Background="{ThemeResource PaperRaisedBrush}"
                                                                    CornerRadius="9"
                                                                    Opacity="{x:Bind OwnedOpacity}">
                                                                    <Grid>
                                                                        <Image Source="{x:Bind PreviewSource}" Stretch="Uniform" />
                                                                        <Border
                                                                            Padding="7,2"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Bottom"
                                                                            Background="{ThemeResource AccentClayBrush}"
                                                                            CornerRadius="7,0,9,0"
                                                                            Opacity="{x:Bind CountBackgroundOpacity}">
                                                                            <TextBlock
                                                                                Foreground="{ThemeResource InkOnAccentBrush}"
                                                                                Style="{StaticResource CaptionUI}"
                                                                                Text="{x:Bind CountText}" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsRepeater.ItemTemplate>
                                                    </ItemsRepeater>
                                                    <StackPanel
                                                        Grid.Row="3"
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <FontIcon
                                                            FontSize="13"
                                                            Foreground="{ThemeResource InkSecondaryBrush}"
                                                            Glyph="&#xE823;" />
                                                        <TextBlock Style="{StaticResource CaptionUI}" Text="{x:Bind RemainingText}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </controls:GlassIsland>

                    <controls:GlassIsland
                        automation:AutomationProperties.Name="心愿记录概览"
                        IslandPadding="0">
                        <Grid>
                            <Grid
                                x:Name="StatsWideGrid"
                                MinHeight="112"
                                ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:StatTile
                                    x:Name="TotalPullsTile"
                                    automation:AutomationProperties.Name="累计共鸣次数"
                                    Label="累计共鸣" />
                                <controls:StatTile
                                    x:Name="FiveStarTile"
                                    Grid.Column="1"
                                    automation:AutomationProperties.Name="已拥有服装槽位"
                                    Label="已拥有槽位" />
                                <controls:StatTile
                                    x:Name="AveragePullsTile"
                                    Grid.Column="2"
                                    automation:AutomationProperties.Name="五星平均抽数"
                                    Label="平均抽数" />
                                <controls:StatTile
                                    x:Name="GuaranteeTile"
                                    Grid.Column="3"
                                    automation:AutomationProperties.Name="共鸣活动数量"
                                    Label="活动数量" />
                            </Grid>
                            <StackPanel
                                x:Name="StatsCompactStack"
                                Padding="12"
                                Spacing="8"
                                Visibility="Collapsed">
                                <controls:StatTile
                                    x:Name="TotalPullsCompactTile"
                                    automation:AutomationProperties.Name="累计共鸣次数"
                                    Label="累计共鸣" />
                                <controls:StatTile
                                    x:Name="FiveStarCompactTile"
                                    automation:AutomationProperties.Name="已拥有服装槽位"
                                    Label="已拥有槽位" />
                                <controls:StatTile
                                    x:Name="AveragePullsCompactTile"
                                    automation:AutomationProperties.Name="五星平均抽数"
                                    Label="平均抽数" />
                                <controls:StatTile
                                    x:Name="GuaranteeCompactTile"
                                    automation:AutomationProperties.Name="共鸣活动数量"
                                    Label="活动数量" />
                            </StackPanel>
                        </Grid>
                    </controls:GlassIsland>

                    <controls:GlassIsland
                        x:Name="PoolFilterIsland"
                        automation:AutomationProperties.Name="心愿记录卡池筛选"
                        IslandPadding="12,8">
                        <ItemsControl
                            x:Name="PoolFilterItems"
                            ItemsSource="{x:Bind PoolFilters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="viewModels:WishPoolFilter"
                                    x:DefaultBindMode="OneTime">
                                    <Button
                                        MinWidth="84"
                                        Padding="10,6"
                                        automation:AutomationProperties.Name="{x:Bind Label}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OnPoolFilterClicked"
                                        Tag="{x:Bind Key}">
                                        <Grid RowSpacing="4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="2" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource BodyStrongUI}"
                                                Text="{x:Bind Label}" />
                                            <Rectangle
                                                Grid.Row="1"
                                                Height="2"
                                                Fill="{ThemeResource DerivedAccentBrush}"
                                                Opacity="{x:Bind IndicatorOpacity}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:GlassIsland>

                    <controls:GlassIsland
                        x:Name="TimelineIsland"
                        automation:AutomationProperties.Name="心愿记录时间轴">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource SectionTitleDisplay}"
                                    Text="时间轴" />
                                <TextBlock
                                    x:Name="WishLastSyncedText"
                                    Grid.Column="1"
                                    Style="{StaticResource CaptionUI}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <ItemsRepeater
                                x:Name="WishHistoryRepeater"
                                ItemsSource="{x:Bind WishRows}"
                                SizeChanged="OnWishHistoryRepeaterSizeChanged">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="viewModels:WishHistoryRow"
                                        x:DefaultBindMode="OneTime">
                                        <Grid Margin="0,0,0,6">
                                            <Rectangle
                                                IsHitTestVisible="False"
                                                Opacity="{x:Bind FiveStarGlowOpacity}">
                                                <Rectangle.Fill>
                                                    <RadialGradientBrush
                                                        Center="0.72,0.5"
                                                        GradientOrigin="0.72,0.5"
                                                        RadiusX="0.74"
                                                        RadiusY="1.4">
                                                        <GradientStop
                                                            Offset="0"
                                                            Color="{Binding Color, Source={StaticResource AccentGoldBrush}}" />
                                                        <GradientStop Offset="1" Color="{ThemeResource OnArtScrimTransparentColor}" />
                                                    </RadialGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <Grid
                                                MinHeight="48"
                                                ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Style="{StaticResource CaptionUI}"
                                                    Text="{x:Bind MonthLabelDisplay}"
                                                    TextWrapping="NoWrap" />
                                                <Grid Grid.Column="1">
                                                    <Rectangle
                                                        Width="2"
                                                        HorizontalAlignment="Center"
                                                        Fill="{ThemeResource HairlineSoftBrush}" />
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Fill="{ThemeResource AccentGoldBrush}" />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    Spacing="2">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock
                                        FontFamily="{ThemeResource DisplayFontFamily}"
                                                            Foreground="{ThemeResource AccentGoldBrush}"
                                                            Text="{x:Bind RarityLabel}" />
                                                        <TextBlock
                                                            Style="{StaticResource BodyStrongUI}"
                                                            Text="{x:Bind ItemLabel}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Style="{StaticResource CaptionUI}"
                                                        Text="{x:Bind PoolLabel}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    HorizontalAlignment="Right"
                                                    Spacing="2">
                                                    <TextBlock
                                                        FontFamily="{StaticResource MonoFontFamily}"
                                                        Style="{StaticResource CaptionUI}"
                                                        Text="{x:Bind PullLabel}"
                                                        TextAlignment="Right" />
                                                    <TextBlock
                                                        Style="{StaticResource CaptionUI}"
                                                        Text="{x:Bind TimeLabel}"
                                                        TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </controls:GlassIsland>
                </StackPanel>
                </StackPanel>
            </ScrollView>
            <AnnotatedScrollBar
                x:Name="WishMonthScrollBar"
                automation:AutomationProperties.Name="按月份浏览心愿记录"
                DetailLabelRequested="OnWishMonthDetailLabelRequested"
                HorizontalAlignment="Right"
                Margin="0,4,4,4"
                SmallChange="160"
                VerticalAlignment="Stretch" />
        </Grid>
    </Grid>
</shell:PageBase>
