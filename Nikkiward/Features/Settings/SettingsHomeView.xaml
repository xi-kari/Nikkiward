<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.SettingsHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <UserControl.Resources>
        <Style
            x:Key="SettingsHomeCardButtonStyle"
            BasedOn="{StaticResource OnArtGlassButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="{ThemeResource CardPaddingThickness}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsHomeWidthStates">
                <VisualState x:Name="NarrowSettingsHome">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimarySettingsSecondColumn.Width" Value="0" />
                        <Setter Target="GallerySettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="GallerySettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="PluginsSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="PluginsSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="GamepadSettingsCard.(Grid.Row)" Value="3" />
                        <Setter Target="GamepadSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="DeveloperSettingsSecondColumn.Width" Value="0" />
                        <Setter Target="FilesSettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="FilesSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="StatusSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="StatusSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="ComponentsSettingsCard.(Grid.Row)" Value="3" />
                        <Setter Target="ComponentsSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="DiagnosticsSettingsCard.(Grid.Row)" Value="4" />
                        <Setter Target="DiagnosticsSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="ContractSettingsCard.(Grid.Row)" Value="5" />
                        <Setter Target="ContractSettingsCard.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSettingsHome">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="620" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PrimarySettingsSecondColumn.Width" Value="*" />
                        <Setter Target="GallerySettingsCard.(Grid.Row)" Value="0" />
                        <Setter Target="GallerySettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="PluginsSettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="PluginsSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="GamepadSettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="GamepadSettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="DeveloperSettingsSecondColumn.Width" Value="*" />
                        <Setter Target="FilesSettingsCard.(Grid.Row)" Value="0" />
                        <Setter Target="FilesSettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="StatusSettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="StatusSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="ComponentsSettingsCard.(Grid.Row)" Value="1" />
                        <Setter Target="ComponentsSettingsCard.(Grid.Column)" Value="1" />
                        <Setter Target="DiagnosticsSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="DiagnosticsSettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="ContractSettingsCard.(Grid.Row)" Value="2" />
                        <Setter Target="ContractSettingsCard.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel Spacing="12">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource OnArtSectionTitleTextStyle}"
            Text="设置中心" />

        <Grid x:Name="PrimarySettingsGrid" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PrimarySettingsSecondColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" automation:AutomationProperties.Name="打开外观设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="general">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE790;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="外观" /><TextBlock FontSize="11" Opacity="0.7" Text="主题、背景与界面体验" TextWrapping="Wrap" /></StackPanel></StackPanel>
            </Button>
            <Button x:Name="GallerySettingsCard" Grid.Row="0" Grid.Column="1" automation:AutomationProperties.Name="打开相册设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="gallery">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEB9F;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="相册" /><TextBlock FontSize="11" Opacity="0.7" Text="图库位置、缓存与高级工具" TextWrapping="Wrap" /></StackPanel></StackPanel>
            </Button>
            <Button x:Name="PluginsSettingsCard" Grid.Row="1" Grid.Column="0" automation:AutomationProperties.Name="打开插件设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="plugins">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B5;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="插件" /><TextBlock FontSize="11" Opacity="0.7" Text="本地插件管理" TextWrapping="Wrap" /></StackPanel></StackPanel>
            </Button>
            <Button x:Name="GamepadSettingsCard" Grid.Row="1" Grid.Column="1" automation:AutomationProperties.Name="打开手柄增强设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="gamepad">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7FC;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="手柄增强" /><TextBlock FontSize="11" Opacity="0.7" Text="导航键与分享键" TextWrapping="Wrap" /></StackPanel></StackPanel>
            </Button>
        </Grid>

        <Grid Padding="4,10,4,2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="开发者模式" />
                <TextBlock FontSize="11" Foreground="{ThemeResource InkTertiaryBrush}" Text="显示缓存、本地资源、诊断与验证工具" />
            </StackPanel>
            <ToggleSwitch
                x:Name="DeveloperModeToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="开发者模式"
                Toggled="OnDeveloperModeToggled" />
        </Grid>

        <StackPanel x:Name="DeveloperToolsPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource OnArtSectionTitleTextStyle}" Text="开发者工具" />
            <Grid x:Name="DeveloperSettingsGrid" ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DeveloperSettingsSecondColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" automation:AutomationProperties.Name="打开手账与缓存设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="journal">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8F1;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="手账与缓存" /><TextBlock FontSize="11" Opacity="0.7" Text="网页登录、快照与缓存" /></StackPanel></StackPanel>
                </Button>
                <Button x:Name="FilesSettingsCard" Grid.Row="0" Grid.Column="1" automation:AutomationProperties.Name="打开本地资源设置" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="files">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="本地资源" /><TextBlock FontSize="11" Opacity="0.7" Text="存储位置与缓存" /></StackPanel></StackPanel>
                </Button>
                <Button x:Name="StatusSettingsCard" Grid.Row="1" Grid.Column="0" automation:AutomationProperties.Name="打开能力与生命周期" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="status">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" /><TextBlock FontWeight="SemiBold" Text="运行状态" /></StackPanel>
                </Button>
                <Button x:Name="ComponentsSettingsCard" Grid.Row="1" Grid.Column="1" automation:AutomationProperties.Name="打开组件验证" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="components">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE90F;" /><TextBlock FontWeight="SemiBold" Text="组件验证" /></StackPanel>
                </Button>
                <Button x:Name="DiagnosticsSettingsCard" Grid.Row="2" Grid.Column="0" automation:AutomationProperties.Name="打开脱敏诊断" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="diagnostics">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xF133;" /><TextBlock FontWeight="SemiBold" Text="脱敏诊断" /></StackPanel>
                </Button>
                <Button x:Name="ContractSettingsCard" Grid.Row="2" Grid.Column="1" automation:AutomationProperties.Name="打开隔离契约" Click="OnDestinationClicked" Style="{StaticResource SettingsHomeCardButtonStyle}" Tag="contract">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8C7;" /><TextBlock FontWeight="SemiBold" Text="隔离契约" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
