<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.SettingsHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="12">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource OnArtSectionTitleTextStyle}"
            Text="设置中心" />

        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开外观设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="general">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE790;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="外观" /><TextBlock FontSize="11" Opacity="0.7" Text="主题、背景与界面体验" /></StackPanel></StackPanel>
            </Button>
            <Button Grid.Row="0" Grid.Column="1" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开相册设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="gallery">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xEB9F;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="相册" /><TextBlock FontSize="11" Opacity="0.7" Text="图库位置、缓存与高级工具" /></StackPanel></StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开插件设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="plugins">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B5;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="插件" /><TextBlock FontSize="11" Opacity="0.7" Text="本地插件管理" /></StackPanel></StackPanel>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开手柄增强设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="gamepad">
                <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE7FC;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="手柄增强" /><TextBlock FontSize="11" Opacity="0.7" Text="导航键与分享键" /></StackPanel></StackPanel>
            </Button>
        </Grid>

        <Grid Padding="4,10,4,2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="开发者模式" />
                <TextBlock FontSize="11" Foreground="{ThemeResource InkTertiaryBrush}" Text="显示缓存、本地资源、诊断与验证工具" />
            </StackPanel>
            <ToggleSwitch
                x:Name="DeveloperModeToggle"
                Grid.Column="1"
                VerticalAlignment="Center"
                automation:AutomationProperties.Name="开发者模式"
                Toggled="OnDeveloperModeToggled" />
        </Grid>

        <StackPanel x:Name="DeveloperToolsPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource OnArtSectionTitleTextStyle}" Text="开发者工具" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Grid.Row="0" Grid.Column="0" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开手账与缓存设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="journal">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8F1;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="手账与缓存" /><TextBlock FontSize="11" Opacity="0.7" Text="网页登录、快照与缓存" /></StackPanel></StackPanel>
                </Button>
                <Button Grid.Row="0" Grid.Column="1" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开本地资源设置" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="files">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8B7;" /><StackPanel><TextBlock FontWeight="SemiBold" Text="本地资源" /><TextBlock FontSize="11" Opacity="0.7" Text="存储位置与缓存" /></StackPanel></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="0" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开能力与生命周期" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="status">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE946;" /><TextBlock FontWeight="SemiBold" Text="运行状态" /></StackPanel>
                </Button>
                <Button Grid.Row="1" Grid.Column="1" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开组件验证" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="components">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE90F;" /><TextBlock FontWeight="SemiBold" Text="组件验证" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="0" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开脱敏诊断" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="diagnostics">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xF133;" /><TextBlock FontWeight="SemiBold" Text="脱敏诊断" /></StackPanel>
                </Button>
                <Button Grid.Row="2" Grid.Column="1" MinHeight="52" Padding="{ThemeResource CardPaddingThickness}" HorizontalContentAlignment="Left" automation:AutomationProperties.Name="打开隔离契约" Click="OnDestinationClicked" Style="{StaticResource OnArtGlassButtonStyle}" Tag="contract">
                    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE8C7;" /><TextBlock FontWeight="SemiBold" Text="隔离契约" /></StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
