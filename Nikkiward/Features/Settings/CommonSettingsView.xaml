<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.CommonSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="18">
        <StackPanel Spacing="4">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="语言" />
            <ComboBox
                x:Name="LanguageComboBox"
                automation:AutomationProperties.Name="应用语言"
                HorizontalAlignment="Left"
                MinWidth="260"
                SelectionChanged="OnLanguageSelectionChanged">
                <ComboBoxItem Content="跟随系统" Tag="system" />
                <ComboBoxItem Content="简体中文" Tag="zh-CN" />
            </ComboBox>
            <HyperlinkButton
                automation:AutomationProperties.Name="帮助改进 Nikkiward 翻译"
                Content="帮助改进 Nikkiward 翻译"
                NavigateUri="https://github.com/xi-kari/Nikkiward" />
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="关闭窗口选项" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <RadioButton
                    x:Name="MinimizeToTrayRadio"
                    automation:AutomationProperties.Name="最小化到系统托盘"
                    Content="最小化到系统托盘"
                    GroupName="CloseWindowBehavior"
                    Tag="tray"
                    Checked="OnWindowBehaviorChecked" />
                <RadioButton
                    x:Name="ExitRadio"
                    automation:AutomationProperties.Name="完全退出"
                    Content="完全退出"
                    GroupName="CloseWindowBehavior"
                    Tag="exit"
                    Checked="OnWindowBehaviorChecked" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="启动游戏后" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <RadioButton
                    x:Name="KeepWindowRadio"
                    Content="保持窗口"
                    GroupName="AfterLaunchBehavior"
                    Checked="OnWindowBehaviorChecked" />
                <RadioButton
                    x:Name="MinimizeRadio"
                    Content="最小化"
                    GroupName="AfterLaunchBehavior"
                    Checked="OnWindowBehaviorChecked" />
                <RadioButton
                    x:Name="HideToTrayRadio"
                    Content="隐藏到托盘"
                    GroupName="AfterLaunchBehavior"
                    Checked="OnWindowBehaviorChecked" />
            </StackPanel>
        </StackPanel>

        <TimePicker x:Name="ChecklistReset" Header="每日清单重置时间" ClockIdentifier="24HourClock" TimeChanged="OnResetChanged" />

        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch x:Name="PlayTimeToggle" Header="记录本机游玩时长"
                    automation:AutomationProperties.Name="记录本机游玩时长"
                    Toggled="OnGeneralToggleChanged" />
                <Button x:Name="ClearPlayTimeButton" Content="清除记录" VerticalAlignment="Bottom"
                    IsEnabled="False" Style="{StaticResource OnArtGlassButtonStyle}" Click="OnClearPlayTimeClicked" />
            </StackPanel>
            <TextBlock x:Name="PlayTimeError" TextWrapping="Wrap" Style="{StaticResource CaptionUI}" Visibility="Collapsed" />
        </StackPanel>


        <StackPanel Spacing="6">
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="为了获得更好的体验，建议在 Windows 系统设置中启用以下功能。"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    automation:AutomationProperties.Name="打开透明效果设置"
                    Click="OnVisualEffectsClicked"
                    Tag="transparency"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <TextBlock Text="透明效果" />
                </Button>
                <Button
                    automation:AutomationProperties.Name="打开动画效果设置"
                    Click="OnVisualEffectsClicked"
                    Tag="animation"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <TextBlock Text="动画效果" />
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
