<?xml version="1.0" encoding="utf-8"?>
<shell:PageBase
    x:Class="Nikkiward.Features.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:shell="using:Nikkiward.Features.Shell"
    Background="{ThemeResource PaperBaseBrush}">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsWidthStates">
                <VisualState x:Name="NarrowSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="SettingsNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="SettingsNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="HeaderLayout.Margin" Value="12,8,160,8" />
                        <Setter Target="HeaderLayout.ColumnSpacing" Value="8" />
                        <Setter Target="PaneToggleButton.Visibility" Value="Visible" />
                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                        <Setter Target="SubtitleText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="500" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsNavigation.PaneDisplayMode" Value="LeftCompact" />
                        <Setter Target="SettingsNavigation.IsPaneOpen" Value="False" />
                        <Setter Target="SettingsNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="HeaderLayout.Margin" Value="12,8,160,8" />
                        <Setter Target="HeaderLayout.ColumnSpacing" Value="8" />
                        <Setter Target="PaneToggleButton.Visibility" Value="Visible" />
                        <Setter Target="TitleText.FontSize" Value="18" />
                        <Setter Target="TitleText.Visibility" Value="Visible" />
                        <Setter Target="SubtitleText.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSettings">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsNavigation.PaneDisplayMode" Value="Left" />
                        <Setter Target="SettingsNavigation.IsPaneOpen" Value="True" />
                        <Setter Target="SettingsNavigation.IsPaneToggleButtonVisible" Value="False" />
                        <Setter Target="HeaderLayout.Margin" Value="24,10,174,12" />
                        <Setter Target="HeaderLayout.ColumnSpacing" Value="12" />
                        <Setter Target="PaneToggleButton.Visibility" Value="Collapsed" />
                        <Setter Target="TitleText.FontSize" Value="20" />
                        <Setter Target="TitleText.Visibility" Value="Visible" />
                        <Setter Target="SubtitleText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <NavigationView
            x:Name="SettingsNavigation"
            AlwaysShowHeader="True"
            Background="Transparent"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="OnItemInvoked"
            CompactModeThresholdWidth="640"
            OpenPaneLength="260"
            PaneDisplayMode="LeftCompact">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewContentMargin">0</Thickness>
                <Thickness x:Key="NavigationViewHeaderMargin">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <TextBlock Margin="16,12,0,8" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource InkPrimaryBrush}" Text="应用设置" />
            </NavigationView.PaneHeader>
            <NavigationView.Header>
                <Grid
                    x:Name="HeaderLayout"
                    Margin="12,8,160,8"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="TitleText"
                            automation:AutomationProperties.HeadingLevel="Level1"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource InkPrimaryBrush}"
                            Text="设置中心" />
                        <TextBlock
                            x:Name="SubtitleText"
                            FontSize="11"
                            Foreground="{ThemeResource InkTertiaryBrush}"
                            Text="外观、插件与输入设置"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel
                        x:Name="HeaderActions"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Name="PaneToggleButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            automation:AutomationProperties.Name="打开设置导航"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPaneToggleClicked"
                            CornerRadius="18">
                            <FontIcon FontSize="15" Glyph="&#xE700;" />
                        </Button>
                        <Button
                            x:Name="CloseButton"
                            Width="36"
                            Height="36"
                            Padding="0"
                            automation:AutomationProperties.Name="关闭设置"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseClicked"
                            CornerRadius="18">
                            <FontIcon FontSize="14" Glyph="&#xE711;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </NavigationView.Header>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="OverviewItem" Content="设置概览" IsSelected="True" Tag="overview" automation:AutomationProperties.Name="设置概览"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="GeneralItem" Content="外观" Tag="general" automation:AutomationProperties.Name="外观设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="GalleryItem" Content="相册" Tag="gallery" automation:AutomationProperties.Name="相册设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="PluginsItem" Content="插件" Tag="plugins" automation:AutomationProperties.Name="插件设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B5;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="键盘快捷键" Tag="hotkeys" automation:AutomationProperties.Name="键盘快捷键设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="GamepadItem" Content="手柄增强" Tag="gamepad" automation:AutomationProperties.Name="手柄增强设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemSeparator x:Name="DeveloperSeparator" Visibility="Collapsed" />
                <NavigationViewItem x:Name="JournalItem" Content="手账与缓存" Tag="journal" Visibility="Collapsed" automation:AutomationProperties.Name="手账与缓存设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="FilesItem" Content="本地资源" Tag="files" Visibility="Collapsed" automation:AutomationProperties.Name="本地资源设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="StatusItem" Content="运行状态" Tag="status" Visibility="Collapsed" automation:AutomationProperties.Name="能力与生命周期"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ComponentsItem" Content="组件验证" Tag="components" Visibility="Collapsed" automation:AutomationProperties.Name="组件验证设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="DiagnosticsItem" Content="脱敏诊断" Tag="diagnostics" Visibility="Collapsed" automation:AutomationProperties.Name="脱敏诊断设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xF133;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="ContractItem" Content="隔离契约" Tag="contract" Visibility="Collapsed" automation:AutomationProperties.Name="隔离契约设置"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8C7;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="AboutItem"
                    automation:AutomationProperties.AutomationId="SettingsAboutNavigationItem"
                    automation:AutomationProperties.Name="关于 Nikkiward"
                    Content="关于"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="ContentScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid
                    MaxWidth="980"
                    Margin="0,0,8,12"
                    Padding="{ThemeResource ContentPaddingThickness}"
                    HorizontalAlignment="Left">
                    <StackPanel x:Name="ContentHost" />
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</shell:PageBase>
