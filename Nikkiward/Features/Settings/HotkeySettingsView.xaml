<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.HotkeySettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="12">
        <TextBlock automation:AutomationProperties.HeadingLevel="Level2" Style="{StaticResource OnArtSectionTitleTextStyle}" Text="键盘快捷键" />
        <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="单键快捷键在游戏中可能需要管理员权限；快捷键文本会保存到本地设置。" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtFieldLabelTextStyle}" Text="显示主窗口" />
            <TextBox x:Name="ShowMainWindowHotkeyTextBox" automation:AutomationProperties.Name="显示主窗口快捷键" LostFocus="OnHotkeyLostFocus" Style="{StaticResource EditableMonospaceTextBoxStyle}" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtFieldLabelTextStyle}" Text="游戏截图" />
            <TextBox x:Name="ScreenshotHotkeyTextBox" automation:AutomationProperties.Name="游戏截图快捷键" LostFocus="OnHotkeyLostFocus" Style="{StaticResource EditableMonospaceTextBoxStyle}" />
        </StackPanel>
        <TextBlock
            x:Name="RegistrationStatusText"
            automation:AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Style="{StaticResource OnArtBodyTextStyle}"
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
