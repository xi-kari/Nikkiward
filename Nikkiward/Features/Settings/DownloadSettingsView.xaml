<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.DownloadSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="默认游戏安装路径" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="后续创建的三渠道单本体会在此目录下建立独立子文件夹，修改默认路径不会移动已有游戏文件。"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ChooseInstallPathButton"
                    automation:AutomationProperties.Name="定位默认游戏安装路径"
                    Click="OnChooseInstallPathClicked"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock Text="定位" />
                    </StackPanel>
                </Button>
                <TextBox
                    x:Name="InstallPathTextBox"
                    Grid.Column="1"
                    automation:AutomationProperties.Name="当前默认游戏安装路径"
                    IsReadOnly="True"
                    Style="{StaticResource EditableMonospaceTextBoxStyle}"
                    Text="尚未选择" />
                <Button
                    x:Name="OpenInstallPathButton"
                    Grid.Column="2"
                    automation:AutomationProperties.Name="打开默认游戏安装路径"
                    Click="OnOpenInstallPathClicked"
                    IsEnabled="False"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <FontIcon Glyph="&#xE8A7;" />
                </Button>
            </Grid>
            <Button
                x:Name="ClearInstallPathButton"
                HorizontalAlignment="Left"
                automation:AutomationProperties.Name="清除默认游戏安装路径"
                Click="OnClearInstallPathClicked"
                IsEnabled="False"
                Style="{StaticResource TextBlockButtonStyle}">
                <TextBlock Text="清除当前路径" />
            </Button>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="硬链接" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="创建硬链接，占用极小的额外存储空间，以安装多个不同区服的游戏客户端。"
                TextWrapping="Wrap" />
            <ToggleSwitch
                x:Name="HardLinksToggle"
                automation:AutomationProperties.Name="启用硬链接"
                OffContent="已禁用"
                OnContent="已启用"
                Toggled="OnHardLinksToggled" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="速度限制" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="数字 0 代表不限速。设置会应用到后续的渠道文件导入。"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumberBox
                    x:Name="SpeedLimitNumberBox"
                    automation:AutomationProperties.Name="下载速度限制"
                    Minimum="0"
                    SmallChange="100"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnSpeedLimitChanged" />
                <TextBlock VerticalAlignment="Center" Text="KB/s" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
