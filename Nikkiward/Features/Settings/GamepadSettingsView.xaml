<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.GamepadSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="12">
        <StackPanel Spacing="3">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="手柄增强" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="仅适配 Xbox 协议手柄，不能保证其他类型手柄的使用体验。启用后接管导航键与分享键，不改动游戏内按键。"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
            <ToggleSwitch
                x:Name="EnableToggle"
                automation:AutomationProperties.Name="启用手柄增强"
                OffContent="已禁用"
                OnContent="已启用"
                Toggled="OnEnableToggled" />
            <TextBlock
                x:Name="StatusText"
                automation:AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="尚未初始化。" />
        </StackPanel>
        <StackPanel x:Name="RedistPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="Windows 10 需要先安装 GameInput 运行库；Windows 11 22000 及以上版本已内置。" />
            <Button automation:AutomationProperties.Name="下载手柄运行库" Click="OnRuntimeDownloadClicked" Style="{StaticResource OnArtGlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE896;" />
                    <TextBlock VerticalAlignment="Center" Text="打开下载页面" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtFieldLabelTextStyle}" Text="长按导航键打开主窗口" />
            <ToggleSwitch
                x:Name="LongPressToggle"
                automation:AutomationProperties.Name="长按导航键打开主窗口"
                OffContent="已禁用"
                OnContent="已启用"
                Toggled="OnLongPressToggled" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="启用后长按导航键约 0.6 秒唤出 Nikkiward，短按才触发下面的映射；关闭后按下即触发映射，但会失去长按手势。" />
        </StackPanel>
        <TextBlock
            automation:AutomationProperties.HeadingLevel="Level3"
            Style="{StaticResource OnArtSectionTitleTextStyle}"
            Text="按键映射" />
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtFieldLabelTextStyle}" Text="导航键" />
            <ComboBox
                x:Name="GuideActionCombo"
                automation:AutomationProperties.Name="导航键映射方式"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnGuideActionChanged">
                <ComboBoxItem Content="无操作" Tag="none" />
                <ComboBoxItem Content="键盘按键" Tag="mapKeys" />
            </ComboBox>
            <TextBox
                x:Name="GuideKeysBox"
                automation:AutomationProperties.Name="导航键映射的键盘按键"
                LostFocus="OnGuideKeysCommitted"
                PlaceholderText="例如 Ctrl Alt F1"
                Style="{StaticResource EditableMonospaceTextBoxStyle}"
                Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtFieldLabelTextStyle}" Text="分享键" />
            <ComboBox
                x:Name="ShareActionCombo"
                automation:AutomationProperties.Name="分享键映射方式"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnShareActionChanged">
                <ComboBoxItem Content="无操作" Tag="none" />
                <ComboBoxItem Content="键盘按键" Tag="mapKeys" />
            </ComboBox>
            <TextBox
                x:Name="ShareKeysBox"
                automation:AutomationProperties.Name="分享键映射的键盘按键"
                LostFocus="OnShareKeysCommitted"
                PlaceholderText="例如 Ctrl Alt F2"
                Style="{StaticResource EditableMonospaceTextBoxStyle}"
                Visibility="Collapsed" />
        </StackPanel>
        <TextBlock
            x:Name="MappingErrorText"
            automation:AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource SystemFillColorCautionBrush}"
            Style="{StaticResource OnArtBodyTextStyle}"
            Visibility="Collapsed" />
        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="· 映射导航键时，Xbox Game Bar 的默认快捷操作将被禁用；其他程序也可能响应导航键，如有冲突需手动关闭相关功能。" />
            <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="· 映射为键盘按键时，请输入键盘按键上的文字，多个按键之间用空格分隔。例如 Ctrl Alt F1；小键盘按键写作 Pad8、Pad+。" />
            <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="· 只有以管理员权限运行 Nikkiward，才能把按键送入以管理员权限运行的游戏窗口。" />
            <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="· 按下分享键仍会触发 Xbox Game Bar 的截图功能。" />
        </StackPanel>
    </StackPanel>
</UserControl>
