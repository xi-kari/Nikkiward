<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.ContractSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    x:DefaultBindMode="OneWay">
    <StackPanel Spacing="12">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource OnArtSectionTitleTextStyle}"
            Text="Profile 隔离契约" />
        <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="{x:Bind ViewModel.ProfileIsolationText}" />
        <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="{x:Bind ViewModel.SwitchParameterText}" />
        <TextBlock
            FontFamily="Consolas"
            FontSize="11"
            Foreground="{ThemeResource OnArtTertiaryTextBrush}"
            Text="{x:Bind ViewModel.SteamProvenanceText}"
            TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="{x:Bind ViewModel.SteamPlatformConditionText}" />
        <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="{x:Bind ViewModel.IpcResearchText}" />
    </StackPanel>
</UserControl>
