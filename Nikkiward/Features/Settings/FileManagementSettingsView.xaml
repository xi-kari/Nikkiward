<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.FileManagementSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="18">
        <StackPanel Spacing="6">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="数据文件夹" />
            <TextBlock
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="您的个人数据保存在下面的文件夹中，它很重要，请不要随意删除。"
                TextWrapping="Wrap" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="ChooseDataFolderButton"
                    automation:AutomationProperties.Name="重新选择数据文件夹"
                    Click="OnChooseDataFolderClicked"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE8B7;" />
                        <TextBlock Text="重新选择" />
                    </StackPanel>
                </Button>
                <TextBox
                    x:Name="DataFolderTextBox"
                    Grid.Column="1"
                    automation:AutomationProperties.Name="当前数据文件夹"
                    IsReadOnly="True"
                    Style="{StaticResource EditableMonospaceTextBoxStyle}"
                    Text="尚未选择" />
                <Button
                    x:Name="OpenDataFolderButton"
                    Grid.Column="2"
                    automation:AutomationProperties.Name="打开数据文件夹"
                    Click="OnOpenDataFolderClicked"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <FontIcon Glyph="&#xE8A7;" />
                </Button>
            </Grid>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="数据库" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="BackupButton"
                    automation:AutomationProperties.Name="备份数据库"
                    Click="OnBackupClicked"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xF413;" />
                        <TextBlock Text="备份数据库" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="BackupProgressRing" Width="20" Height="20" Visibility="Collapsed" />
                <Button
                    x:Name="OpenBackupButton"
                    automation:AutomationProperties.Name="打开最近备份"
                    Click="OnOpenBackupClicked"
                    IsEnabled="False"
                    Style="{StaticResource TextBlockButtonStyle}">
                    <TextBlock x:Name="LastBackupText" Text="尚无备份" />
                </Button>
            </StackPanel>
            <Button
                x:Name="DeleteAllSettingsButton"
                HorizontalAlignment="Left"
                automation:AutomationProperties.Name="删除所有设置"
                Click="OnDeleteAllSettingsClicked"
                Style="{StaticResource OnArtGlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock Text="删除所有设置" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="日志" />
            <Button
                x:Name="OpenLogsButton"
                HorizontalAlignment="Left"
                automation:AutomationProperties.Name="打开日志文件夹"
                Click="OnOpenLogsClicked"
                Style="{StaticResource OnArtGlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE838;" />
                    <TextBlock Text="打开日志文件夹" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource OnArtSectionTitleTextStyle}"
                Text="缓存" />
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="日志" />
                    <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="图片" />
                    <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="浏览器" />
                    <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="游戏资源" />
                    <TextBlock Style="{StaticResource OnArtBodyTextStyle}" Text="启动器背景" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="LogCacheSizeText" Style="{StaticResource OnArtBodyTextStyle}" Text="读取中" />
                    <TextBlock x:Name="ImageCacheSizeText" Style="{StaticResource OnArtBodyTextStyle}" Text="读取中" />
                    <TextBlock x:Name="BrowserCacheSizeText" Style="{StaticResource OnArtBodyTextStyle}" Text="读取中" />
                    <TextBlock x:Name="GameCacheSizeText" Style="{StaticResource OnArtBodyTextStyle}" Text="读取中" />
                    <TextBlock x:Name="LauncherBackgroundSizeText" Style="{StaticResource OnArtBodyTextStyle}" Text="读取中" />
                </StackPanel>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="ClearCacheButton"
                    automation:AutomationProperties.Name="清理缓存"
                    Click="OnClearCacheClicked"
                    Style="{StaticResource OnArtGlassButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xEA99;" />
                        <TextBlock Text="清理缓存" />
                    </StackPanel>
                </Button>
                <ProgressRing x:Name="ClearCacheProgressRing" Width="20" Height="20" Visibility="Collapsed" />
            </StackPanel>
            <CheckBox
                x:Name="ClearLauncherBackgroundCheckBox"
                automation:AutomationProperties.Name="清理启动器背景文件"
                Content="清理启动器背景文件"
                Checked="OnClearLauncherBackgroundChanged"
                Unchecked="OnClearLauncherBackgroundChanged" />
            <TextBlock
                x:Name="StatusText"
                automation:AutomationProperties.LiveSetting="Polite"
                Style="{StaticResource OnArtBodyTextStyle}"
                Text="" />
        </StackPanel>
    </StackPanel>
</UserControl>
