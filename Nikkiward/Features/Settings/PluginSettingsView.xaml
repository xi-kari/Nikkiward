<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <StackPanel Spacing="12">
        <TextBlock
            automation:AutomationProperties.HeadingLevel="Level2"
            Style="{StaticResource OnArtSectionTitleTextStyle}"
            Text="插件" />
        <Border Style="{StaticResource ComponentCardBorderStyle}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="52"
                    Height="52"
                    VerticalAlignment="Center"
                    Background="{ThemeResource GlassIslandBrush}"
                    CornerRadius="14">
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource OnArtSecondaryTextBrush}"
                        Glyph="&#xE8B5;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource OnArtPrimaryTextBrush}"
                        Text="相册插件" />
                    <TextBlock
                        x:Name="PhotoPluginSettingsStatusText"
                        automation:AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource OnArtTertiaryTextBrush}"
                        Text="尚未安装" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="PhotoPluginImportButton"
                        automation:AutomationProperties.Name="导入相册插件"
                        Click="OnImportClicked"
                        Style="{StaticResource OnArtGlassButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8B5;" />
                            <TextBlock VerticalAlignment="Center" Text="导入插件" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PhotoPluginOpenButton"
                        automation:AutomationProperties.Name="打开相册插件"
                        Click="OnOpenClicked"
                        IsEnabled="False"
                        Style="{StaticResource OnArtGlassButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8A7;" />
                            <TextBlock VerticalAlignment="Center" Text="打开" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PhotoPluginUninstallButton"
                        automation:AutomationProperties.Name="卸载相册插件"
                        Click="OnUninstallClicked"
                        IsEnabled="False"
                        Style="{StaticResource OnArtGlassButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE74D;" />
                            <TextBlock VerticalAlignment="Center" Text="卸载" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
