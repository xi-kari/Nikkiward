<?xml version="1.0" encoding="utf-8"?>
<shell:PageBase
    x:Class="Nikkiward.Features.Gallery.PhotoPluginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:shell="using:Nikkiward.Features.Shell"
    Background="{ThemeResource PaperBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,10,20,8">
            <TextBlock
                automation:AutomationProperties.HeadingLevel="Level1"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource InkPrimaryBrush}"
                Text="相册插件" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            Padding="24,0,20,24"
            VerticalScrollBarVisibility="Auto">
            <Border
                Height="244"
                Background="{ThemeResource PaperRaisedBrush}"
                BorderBrush="{ThemeResource HairlineSoftBrush}"
                BorderThickness="1"
                CornerRadius="18"
                RequestedTheme="Dark"
                Shadow="{ThemeResource WarmThemeShadow}">
                <Grid>
                    <Image
                        Opacity="0.5"
                        Source="Assets/NikkiDefaultBackground.jpg"
                        Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0" Color="{ThemeResource ArtHeroShadeDeepColor}" />
                                <GradientStop Offset="0.68" Color="{ThemeResource ArtHeroShadeStrongColor}" />
                                <GradientStop Offset="1" Color="{ThemeResource ArtHeroShadeSoftColor}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Padding="26" ColumnSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="76"
                            Height="76"
                            VerticalAlignment="Center"
                            Background="{ThemeResource JournalPaperBrush}"
                            CornerRadius="20">
                            <FontIcon
                                FontSize="36"
                                Foreground="{ThemeResource DerivedAccentBrush}"
                                Glyph="&#xE8B5;" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <TextBlock
                                FontSize="25"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource OnArtPrimaryTextBrush}"
                                Text="无限暖暖照片导入" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    x:Name="StatusText"
                                    Foreground="{ThemeResource OnArtSecondaryTextBrush}"
                                    Text="已安装" />
                                <TextBlock
                                    x:Name="VersionText"
                                    Foreground="{ThemeResource OnArtTertiaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="OpenButton"
                                    automation:AutomationProperties.Name="打开照片导入插件"
                                    Click="OnOpenClicked"
                                    Style="{StaticResource PrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B5;" />
                                        <TextBlock VerticalAlignment="Center" Text="打开插件" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    automation:AutomationProperties.Name="打开照片导入插件设置"
                                    Click="OnSettingsClicked"
                                    Style="{StaticResource OnArtGlassButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE713;" />
                                        <TextBlock VerticalAlignment="Center" Text="插件设置" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</shell:PageBase>
