<Page x:Class="Nikkiward.Features.Pages.WebPageErrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="这个页面暂时无法显示。" />
        <TextBlock x:Name="Reason" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="重试" Click="OnRetry" />
            <Button Content="回首页" Click="OnHome" />
        </StackPanel>
    </StackPanel>
</Page>
