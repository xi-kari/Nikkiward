<Page x:Class="Nikkiward.Features.Pages.WebPageErrorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Background="{x:Bind Background, Mode=OneWay}" Padding="24" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
        <StackPanel HorizontalAlignment="Center" MaxWidth="520" Spacing="14">
            <TextBlock x:Name="Heading" Text="这个页面暂时无法显示。" FontSize="26" TextWrapping="Wrap" />
            <TextBlock x:Name="Reason" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="重试" Style="{StaticResource AccentButtonStyle}" Click="OnRetry" />
                <Button Content="回首页" Click="OnHome" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
