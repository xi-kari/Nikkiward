<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Nikkiward.Features.Journal.JournalSnapshotPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:Nikkiward.Controls"
    xmlns:viewModels="using:Nikkiward.ViewModels"
    Visibility="Collapsed">
    <StackPanel Spacing="18">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource PageTitleDisplay}" Text="旅程全卷" />
                <TextBlock
                    Style="{StaticResource CaptionUI}"
                    Text="按官方页面分组保留条目、进度与本地图片缓存" />
            </StackPanel>
            <TextBlock
                x:Name="LastSyncedText"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Style="{StaticResource CaptionUI}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <controls:GlassIsland
            x:Name="ScheduleSection"
            automation:AutomationProperties.Name="日程便利贴完整内容"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Foreground="{ThemeResource AccentGoldBrush}"
                        Glyph="&#xE787;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionTitleDisplay}"
                        Text="日程便利贴" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind ScheduleTasks}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="10"
                            MinItemWidth="210"
                            MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalTaskViewModel" x:DefaultBindMode="OneTime">
                            <Border
                                MinHeight="104"
                                Padding="14"
                                Background="{ThemeResource PaperSunkenBrush}"
                                CornerRadius="10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyStrongUI}" Text="{x:Bind Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Foreground="{ThemeResource AccentClayBrush}"
                                            Style="{StaticResource BodyStrongUI}"
                                            Text="{x:Bind Progress}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Foreground="{ThemeResource AccentGoldBrush}"
                                        Style="{StaticResource CaptionUI}"
                                        Text="{x:Bind Status}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        MaxLines="2"
                                        Style="{StaticResource CaptionUI}"
                                        Text="{x:Bind Detail}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </controls:GlassIsland>

        <controls:GlassIsland
            x:Name="ExplorationSection"
            automation:AutomationProperties.Name="探索总览完整内容"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Foreground="{ThemeResource AccentMintBrush}"
                        Glyph="&#xE707;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionTitleDisplay}"
                        Text="探索总览" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionUI}"
                        Text="完整收集条目" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ExploreGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalExploreGroupViewModel" x:DefaultBindMode="OneTime">
                            <Grid Margin="0,0,0,18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SectionTitleDisplay}" Text="{x:Bind Name}" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="9,3"
                                        Background="{ThemeResource AccentGoldBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="{ThemeResource InkOnAccentBrush}"
                                            Style="{StaticResource CaptionUI}"
                                            Text="{x:Bind Status}" />
                                    </Border>
                                </Grid>
                                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MinColumnSpacing="10"
                                            MinItemWidth="142"
                                            MinRowSpacing="10" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:JournalExploreItemViewModel" x:DefaultBindMode="OneTime">
                                             <Border
                                                 MinHeight="152"
                                                 Padding="12"
                                                 Background="{ThemeResource PaperSunkenBrush}"
                                                 CornerRadius="12"
                                                 PointerEntered="OnImageCardPointerEntered"
                                                 PointerExited="OnImageCardPointerExited"
                                                 PointerPressed="OnImageCardPointerPressed"
                                                 PointerReleased="OnImageCardPointerReleased">
                                                <Grid RowSpacing="8">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="72" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Ellipse
                                                            Width="68"
                                                            Height="68"
                                                            HorizontalAlignment="Center"
                                                            Fill="{ThemeResource PaperRaisedBrush}"
                                                            Stroke="{ThemeResource AccentGoldBrush}"
                                                            StrokeThickness="2" />
                                                        <Image
                                                            Width="58"
                                                            Height="58"
                                                            HorizontalAlignment="Center"
                                                            Source="{x:Bind PreviewSource}"
                                                            Stretch="Uniform"
                                                            Visibility="{x:Bind ImageVisibility}" />
                                                        <FontIcon
                                                            HorizontalAlignment="Center"
                                                            Foreground="{ThemeResource InkTertiaryBrush}"
                                                            Glyph="&#xE8B7;"
                                                            Visibility="{x:Bind PlaceholderVisibility}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        HorizontalAlignment="Center"
                                                        Style="{StaticResource BodyStrongUI}"
                                                        Text="{x:Bind Name}"
                                                        TextAlignment="Center" />
                                                    <StackPanel
                                                        Grid.Row="2"
                                                        HorizontalAlignment="Center"
                                                        Orientation="Horizontal"
                                                        Spacing="6">
                                                        <TextBlock
                                                            Foreground="{ThemeResource AccentGoldBrush}"
                                                            Style="{StaticResource BodyStrongUI}"
                                                            Text="{x:Bind Progress}" />
                                                        <TextBlock Style="{StaticResource CaptionUI}" Text="{x:Bind Status}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:GlassIsland>

        <controls:GlassIsland
            x:Name="BlessingSection"
            automation:AutomationProperties.Name="祝福闪光完整内容"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Foreground="{ThemeResource AccentGoldBrush}" Glyph="&#xE7C1;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionTitleDisplay}"
                        Text="祝福闪光" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind BlessingRecords}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="10"
                            MinItemWidth="156"
                            MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalRecordViewModel" x:DefaultBindMode="OneTime">
                            <Border
                                MinHeight="150"
                                Padding="10"
                                Background="{ThemeResource PaperSunkenBrush}"
                                CornerRadius="10"
                                PointerEntered="OnImageCardPointerEntered"
                                PointerExited="OnImageCardPointerExited"
                                PointerPressed="OnImageCardPointerPressed"
                                PointerReleased="OnImageCardPointerReleased">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="86" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Background="{ThemeResource PaperRaisedBrush}" CornerRadius="8">
                                        <Grid>
                                            <Image
                                                Source="{x:Bind PreviewSource}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind ImageVisibility}" />
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AccentGoldBrush}"
                                                Glyph="&#xE8B7;"
                                                Visibility="{x:Bind PlaceholderVisibility}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource BodyStrongUI}"
                                        Text="{x:Bind Label}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Row="2"
                                        MaxLines="2"
                                        Style="{StaticResource CaptionUI}"
                                        Text="{x:Bind Value}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </controls:GlassIsland>

        <controls:GlassIsland
            x:Name="CrownSection"
            automation:AutomationProperties.Name="奇迹之冠完整内容"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Foreground="{ThemeResource AccentLilacBrush}" Glyph="&#xE734;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionTitleDisplay}"
                        Text="奇迹之冠" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind CrownRecords}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinColumnSpacing="10"
                            MinItemWidth="240"
                            MinRowSpacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalRecordViewModel" x:DefaultBindMode="OneTime">
                            <Border
                                MinHeight="94"
                                Padding="14"
                                Background="{ThemeResource PaperSunkenBrush}"
                                CornerRadius="10">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongUI}"
                                        Text="{x:Bind Label}" />
                                    <TextBlock
                                        Foreground="{ThemeResource AccentLilacBrush}"
                                        MaxLines="3"
                                        Style="{StaticResource CaptionUI}"
                                        Text="{x:Bind Value}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </controls:GlassIsland>

        <Grid x:Name="JournalDetailGrid" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:GlassIsland
                x:Name="NotebookPanel"
                automation:AutomationProperties.Name="奇想札记完整内容"
                Background="{ThemeResource PaperRaisedBrush}"
                IslandCornerRadius="12">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Foreground="{ThemeResource AccentMintBrush}" Glyph="&#xE70B;" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource SectionTitleDisplay}"
                            Text="奇想札记" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind NotebookRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:JournalRecordViewModel" x:DefaultBindMode="OneTime">
                                <Grid
                                    MinHeight="54"
                                    Margin="0,0,0,6"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{ThemeResource PaperSunkenBrush}" CornerRadius="8">
                                        <Grid>
                                            <Image
                                                Source="{x:Bind PreviewSource}"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind ImageVisibility}" />
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource AccentGoldBrush}"
                                                Glyph="&#xE8F1;"
                                                Visibility="{x:Bind PlaceholderVisibility}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongUI}"
                                        Text="{x:Bind Label}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        MaxWidth="180"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource AccentMintBrush}"
                                        Style="{StaticResource BodyUI}"
                                        Text="{x:Bind Value}"
                                        TextAlignment="Right"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </controls:GlassIsland>

            <controls:GlassIsland
                x:Name="WishPanel"
                Grid.Column="1"
                automation:AutomationProperties.Name="心愿共鸣完整统计"
                Background="{ThemeResource PaperSunkenBrush}"
                IslandCornerRadius="12">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Foreground="{ThemeResource AccentGoldBrush}" Glyph="&#xF4A5;" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource SectionTitleDisplay}"
                            Text="心愿共鸣" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind WishStats}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinColumnSpacing="8"
                                MinItemWidth="118"
                                MinRowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:JournalStatViewModel" x:DefaultBindMode="OneTime">
                                <Border
                                    MinHeight="104"
                                    Padding="12"
                                    Background="{ThemeResource PaperRaisedBrush}"
                                    CornerRadius="10">
                                    <StackPanel Spacing="5">
                                        <TextBlock Style="{StaticResource CaptionUI}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            Foreground="{ThemeResource AccentClayBrush}"
                                            Style="{StaticResource StatNumberDisplay}"
                                            Text="{x:Bind Value}" />
                                        <TextBlock Style="{StaticResource CaptionUI}" Text="{x:Bind Detail}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </controls:GlassIsland>
        </Grid>

        <controls:GlassIsland
            x:Name="WardrobeSection"
            automation:AutomationProperties.Name="共鸣衣橱页面预览"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Foreground="{ThemeResource AccentBlushBrush}" Glyph="&#xE8B9;" />
                    <TextBlock
                        Grid.Column="1"
                        Style="{StaticResource SectionTitleDisplay}"
                        Text="共鸣衣橱" />
                </Grid>
                <ItemsRepeater ItemsSource="{x:Bind WardrobePreviews}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalWardrobePreviewViewModel" x:DefaultBindMode="OneTime">
                             <Border
                                 MinHeight="220"
                                 Background="{ThemeResource PaperSunkenBrush}"
                                 CornerRadius="14"
                                 PointerEntered="OnImageCardPointerEntered"
                                 PointerExited="OnImageCardPointerExited"
                                 PointerPressed="OnImageCardPointerPressed"
                                 PointerReleased="OnImageCardPointerReleased">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Image
                                            Source="{x:Bind PreviewSource}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind ImageVisibility}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="64"
                                            Foreground="{ThemeResource AccentGoldBrush}"
                                            Glyph="&#xE8B9;"
                                            Visibility="{x:Bind PlaceholderVisibility}" />
                                    </Grid>
                                    <Grid Grid.Column="1" Margin="0,16,18,16" RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource PageTitleDisplay}" Text="{x:Bind OutfitTitle}" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="14,7"
                                                Background="{ThemeResource AccentGoldBrush}"
                                                CornerRadius="0,12,0,12">
                                                <TextBlock
                                                    Foreground="{ThemeResource InkOnAccentBrush}"
                                                    Style="{StaticResource BodyStrongUI}"
                                                    Text="{x:Bind PatchTitle}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Grid.Row="1"
                                            Style="{StaticResource BodyUI}"
                                            Text="{x:Bind Summary}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Foreground="{ThemeResource AccentClayBrush}"
                                            Style="{StaticResource StatNumberDisplay}"
                                            Text="{x:Bind Completion}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Style="{StaticResource CaptionUI}"
                                            Text="{x:Bind Remaining}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </controls:GlassIsland>

        <controls:GlassIsland
            x:Name="ResourceSection"
            automation:AutomationProperties.Name="网页全部已缓存美术资源"
            Background="{ThemeResource PaperRaisedBrush}"
            IslandCornerRadius="12"
            Visibility="Collapsed">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Foreground="{ThemeResource AccentLilacBrush}" Glyph="&#xE8B7;" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Style="{StaticResource SectionTitleDisplay}" Text="网页美术资源" />
                        <TextBlock
                            Style="{StaticResource CaptionUI}"
                            Text="以下图片来自本次官方页面快照的本地缓存" />
                    </StackPanel>
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ResourceGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:JournalResourceGroupViewModel" x:DefaultBindMode="OneTime">
                            <Grid Margin="0,0,0,18" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongUI}" Text="{x:Bind Title}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionUI}"
                                        Text="{x:Bind CountText}" />
                                </Grid>
                                <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Items}">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout
                                            MinColumnSpacing="8"
                                            MinItemWidth="112"
                                            MinRowSpacing="8" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:JournalResourceThumbViewModel" x:DefaultBindMode="OneTime">
                                             <Border
                                                 MinHeight="128"
                                                 Background="{ThemeResource PaperSunkenBrush}"
                                                 CornerRadius="10"
                                                 PointerEntered="OnImageCardPointerEntered"
                                                 PointerExited="OnImageCardPointerExited"
                                                 PointerPressed="OnImageCardPointerPressed"
                                                 PointerReleased="OnImageCardPointerReleased">
                                                <Grid>
                                                    <Image Source="{x:Bind PreviewSource}" Stretch="UniformToFill" />
                                                    <Rectangle Fill="{ThemeResource ArtVignetteStrongBrush}" />
                                                    <TextBlock
                                                        Margin="9"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom"
                                                        Foreground="{ThemeResource OnArtPrimaryTextBrush}"
                                                        MaxLines="2"
                                                        Style="{StaticResource CaptionUI}"
                                                        Text="{x:Bind Label}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </controls:GlassIsland>
    </StackPanel>
</UserControl>
