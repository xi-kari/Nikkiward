<Page x:Class="Nikkiward.Features.Journal.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Grid Background="{x:Bind Background, Mode=OneWay}" RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="Auto,*" Padding="8,0" ColumnSpacing="8">
            <CommandBar Background="Transparent" DefaultLabelPosition="Collapsed" OverflowButtonVisibility="Auto">
                <AppBarButton Icon="Back" Label="返回" Click="OnBrowserCloseClicked" />
                <AppBarSeparator />
                <AppBarButton x:Name="BackButton" Icon="Previous" Label="后退" Click="OnBackClicked" IsEnabled="False" />
                <AppBarButton x:Name="ForwardButton" Icon="Next" Label="前进" Click="OnForwardClicked" IsEnabled="False" />
                <AppBarButton Icon="Refresh" Label="刷新" Click="OnReloadClicked" />
                <AppBarButton Icon="Sync" Label="同步" Click="OnSyncClicked" />
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="在系统浏览器打开" Click="OnExternalClicked" />
                    <AppBarButton Label="清除本地缓存" Click="OnClearCacheClicked" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <TextBlock Grid.Column="1" x:Name="BrowserStatusText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <InfoBar Grid.Row="1" x:Name="SyncStatusBar" IsClosable="False" />
        <WebView2 Grid.Row="2" x:Name="JournalWebView" AutomationProperties.Name="官方奇想手账网页"
            NavigationStarting="OnNavigationStarting" NavigationCompleted="OnNavigationCompleted" Visibility="Collapsed" />
        <ProgressRing Grid.Row="2" x:Name="BrowserProgress" Width="28" Height="28" Visibility="Collapsed" IsActive="False" />
    </Grid>
</Page>
