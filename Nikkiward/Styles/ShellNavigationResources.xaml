<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E62A2320" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF241E1B" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF241E1B" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#68E8A0B4" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#7CE8A0B4" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#25241E1B" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#E6EFE7DD" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFF7F2EA" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFF7F2EA" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#68E8A0B4" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#7CE8A0B4" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#25F7F2EA" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

</ResourceDictionary>
