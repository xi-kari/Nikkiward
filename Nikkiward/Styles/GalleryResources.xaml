<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="GalleryCommandBarHeight">48</x:Double>
    <x:Double x:Key="GalleryPageHorizontalPadding">24</x:Double>
    <x:Double x:Key="GallerySearchBoxWidth">240</x:Double>
    <x:Double x:Key="GalleryGridMinItemWidth">204</x:Double>
    <x:Double x:Key="GalleryGridMinItemHeight">115</x:Double>
    <x:Double x:Key="GalleryGridSpacing">12</x:Double>
    <x:Double x:Key="GalleryPreviewMinZoom">0.25</x:Double>
    <x:Double x:Key="GalleryPreviewMaxZoom">5</x:Double>
    <x:Double x:Key="GalleryPreviewEdgeButtonWidth">72</x:Double>
    <x:Double x:Key="GalleryDetailsPaneWidth">360</x:Double>

    <Style x:Key="GalleryGridViewItemStyle" TargetType="GridViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="GalleryIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource InkPrimaryBrush}" />
    </Style>

    <Style
        x:Key="GalleryPreviewOnArtIconButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource GalleryIconButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
    </Style>

    <Style x:Key="GalleryPreviewEdgeButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource GalleryPreviewEdgeButtonWidth}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="8,48" />
        <Setter Property="Background" Value="{ThemeResource OnArtPlateBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource OnArtStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OnArtPrimaryTextBrush}" />
    </Style>
</ResourceDictionary>
